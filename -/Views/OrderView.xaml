<UserControl x:Class="Vda5050AgvSimulator.Views.OrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>

        <!-- ================= 文本样式 ================= -->
        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>

        <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="FieldValueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- ================= 按钮样式 ================= -->
        <Style x:Key="ButtonStandard" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ButtonPrimary" TargetType="Button" BasedOn="{StaticResource ButtonStandard}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= DataGrid 扁平化样式 ================= -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ModernDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="ModernDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF" />
                    <Setter Property="Foreground" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 模块一：订单概要 ================= -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12">

            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.03" BlurRadius="6" Direction="270" ShadowDepth="2" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="订单概要"
                           Style="{StaticResource SectionTitleTextStyle}"
                           Margin="0,0,0,12" />

                <!-- 使用均分列的 Grid 来代替固定的像素宽度，适配性更好 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>

                    <!-- 第一行 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Order Id:"
                               Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="-" Style="{StaticResource FieldValueTextStyle}" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Update Id:"
                               Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="-" Style="{StaticResource FieldValueTextStyle}" />

                    <!-- 第二行 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="目标节点:" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="-" Style="{StaticResource FieldValueTextStyle}" />

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="订单状态:" Style="{StaticResource FieldLabelTextStyle}" />
                    <!-- 状态加上颜色以示区分 -->
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="无任务" Style="{StaticResource FieldValueTextStyle}"
                               Foreground="#6B7280" />
                </Grid>
            </Grid>
        </Border>

        <!-- ================= 模块二：节点边列表 ================= -->
        <!-- 外层加一个 Border 统一表格区域的圆角和边框 -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">

            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.03" BlurRadius="6" Direction="270" ShadowDepth="2" />
            </Border.Effect>

            <TabControl Background="Transparent" BorderThickness="0" Margin="4,4,4,0">

                <!-- 节点列表 -->
                <TabItem Header="Nodes" Background="Transparent">
                    <DataGrid AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Style="{StaticResource ModernDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                              CellStyle="{StaticResource ModernDataGridCellStyle}"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sequence" Binding="{Binding SequenceId}" Width="80" />
                            <DataGridTextColumn Header="NodeId" Binding="{Binding NodeId}" Width="*" />
                            <DataGridTextColumn Header="Released" Binding="{Binding Released}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- 边列表 -->
                <TabItem Header="Edges" Background="Transparent">
                    <DataGrid AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Style="{StaticResource ModernDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                              CellStyle="{StaticResource ModernDataGridCellStyle}"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sequence" Binding="{Binding SequenceId}" Width="80" />
                            <DataGridTextColumn Header="EdgeId" Binding="{Binding EdgeId}" Width="*" />
                            <DataGridTextColumn Header="Start" Binding="{Binding StartNodeId}" Width="100" />
                            <DataGridTextColumn Header="End" Binding="{Binding EndNodeId}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ================= 模块三：操作按钮 ================= -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="清除订单"
                    Style="{StaticResource ButtonStandard}"
                    Margin="0,0,6,0" />

            <Button Grid.Column="1"
                    Content="模拟完成"
                    Style="{StaticResource ButtonPrimary}"
                    Margin="6,0,0,0" />
        </Grid>

    </Grid>
</UserControl>