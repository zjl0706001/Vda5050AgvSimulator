<UserControl
    x:Class="Vda5050AgvSimulator.Views.AgvMapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!--  地图画布外层边框：只负责圆角和边框  -->
    <Border
        Margin="10"
        Padding="1"
        Background="#D1D5DB"
        CornerRadius="12">

        <!--  地图内容层：负责背景和圆角裁剪  -->
