            <!--  右上角小状态  -->
            <Border
                Margin="12"
                Padding="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8">

                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="地图状态" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="#6B7280"
                        Text="节点：0" />
                    <TextBlock
                        FontSize="12"
                        Foreground="#6B7280"
                        Text="路线：0" />
                    <TextBlock
