<UserControl x:Class="Vda5050AgvSimulator.Views.EditAgvPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance }">

    <Border Width="760"
            MaxHeight="820"
            Background="White"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="12"
            Padding="0">

        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="20"
                              ShadowDepth="5"
                              Opacity="0.20" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    Padding="18,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <primitives:Thumb Grid.Column="0"
                                      Cursor="SizeAll"
                                      DragDelta="HeaderDragThumb_DragDelta">
                        <primitives:Thumb.Template>
                            <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </primitives:Thumb.Template>
                    </primitives:Thumb>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="修改 AGV"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#111827" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="关闭"
                            Width="64"
                            Height="30"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <!-- 内容区 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="18">

                    <!-- 1. 基础信息 -->
                    <Border Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,12">

                        <StackPanel>
                            <TextBlock Text="1. 基础信息"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#1F2937"
                                       Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="38" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="设备类型"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Height="30"
                                         Text="{Binding DeviceTypeText}"
                                         IsReadOnly="True"
                                         Background="#F3F4F6"
                                         Foreground="#6B7280"
                                         VerticalContentAlignment="Center" />

                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="电量(%)"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <TextBox Grid.Row="0" Grid.Column="3"
                                         Height="30"
                                         Text="{Binding EditingAgv.Equantity, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" />

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="本地IP"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Height="30"
                                         Text="{Binding EditingAgv.LocalIP, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" />

                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="本地端口"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <TextBox Grid.Row="1" Grid.Column="3"
                                         Height="30"
                                         Text="{Binding EditingAgv.LocalPort, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" />

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="远程IP"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Height="30"
                                         Text="{Binding EditingAgv.RemoteIP, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" />

                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Text="远程端口"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <TextBox Grid.Row="2" Grid.Column="3"
                                         Height="30"
                                         Text="{Binding EditingAgv.RemotePort, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" />

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="地标点"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <TextBox x:Name="PositionIdTextBox"
                                         Grid.Row="3" Grid.Column="1"
                                         Height="30"
                                         Text="{Binding EditingAgv.PositionID, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         TextChanged="PositionIdTextBox_TextChanged" />

                                <TextBlock Grid.Row="3" Grid.Column="2"
                                           Text="角度(°)"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <TextBox Grid.Row="3" Grid.Column="3"
                                         Height="30"
                                         Text="{Binding EditingAgv.Angle, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" />

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Text="坐标X(m)"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <TextBox x:Name="CoordinateXTextBox"
                                         Grid.Row="4" Grid.Column="1"
                                         Height="30"
                                         Text="{Binding EditingAgv.X, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="True"
                                         Background="#F3F4F6"
                                         Foreground="#6B7280"
                                         VerticalContentAlignment="Center" />

                                <TextBlock Grid.Row="4" Grid.Column="2"
                                           Text="坐标Y(m)"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <TextBox x:Name="CoordinateYTextBox"
                                         Grid.Row="4" Grid.Column="3"
                                         Height="30"
                                         Text="{Binding EditingAgv.Y, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="True"
                                         Background="#F3F4F6"
                                         Foreground="#6B7280"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. 运行信息 -->
                    <Border Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,12">

                        <StackPanel>
                            <TextBlock Text="2. 运行信息"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#1F2937"
                                       Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="38" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="运行状态"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          Height="30"
                                          ItemsSource="{Binding RunStatusOptions}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding EditingAgv.RunStatus, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="运行方向"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <ComboBox Grid.Row="0" Grid.Column="3"
                                          Height="30"
                                          ItemsSource="{Binding RunDirectionOptions}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding EditingAgv.RunDirection, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="运行速度(m/s)"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Height="30"
                                         Language="en-US"
                                         Text="{Binding EditingAgv.Speed, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         VerticalContentAlignment="Center" />

                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="避障区域"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <ComboBox Grid.Row="1" Grid.Column="3"
                                          Height="30"
                                          ItemsSource="{Binding DodgeAreaOptions}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding EditingAgv.DodgeArea, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="在线状态"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <ComboBox Grid.Row="2" Grid.Column="1"
                                          Height="30"
                                          ItemsSource="{Binding OnlineStatusOptions}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding EditingAgv.OnlineStatus, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Text="管制状态"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <ComboBox Grid.Row="2" Grid.Column="3"
                                          Height="30"
                                          ItemsSource="{Binding TrafficStatusOptions}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding EditingAgv.TrafficStatus, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="充电状态"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <ComboBox Grid.Row="3" Grid.Column="1"
                                          Height="30"
                                          ItemsSource="{Binding ChargeStatusOptions}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding EditingAgv.ChargeStatus, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. 其他信息 -->
                    <Border Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,12">

                        <StackPanel>
                            <TextBlock Text="3. 其他信息"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#1F2937"
                                       Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="载货状态"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          Height="30"
                                          ItemsSource="{Binding LoadStatusOptions}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding EditingAgv.LoadStatus, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="报警码"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563" />

                                <TextBox Grid.Row="0" Grid.Column="3"
                                         Height="30"
                                         Text="{Binding EditingAgv.AlarmCode, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 4. 动作编辑器 -->
                    <Border Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">

                        <StackPanel>
                            <TextBlock Text="4. 动作编辑器"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#1F2937"
                                       Margin="0,0,0,10" />

                            <!-- actions -->
                            <Border Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,0,12">

                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="actions 动作列表"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"
                                                   VerticalAlignment="Center" />

                                        <Button Grid.Column="1"
                                                Content="新增动作"
                                                Width="80"
                                                Height="28"
                                                Margin="0,0,8,0"
                                                Click="AddActionButton_Click" />

                                        <Button Grid.Column="2"
                                                Content="删除动作"
                                                Width="80"
                                                Height="28"
                                                Click="DeleteActionButton_Click" />
                                    </Grid>

                                    <DataGrid x:Name="ActionDataGrid"
                                              ItemsSource="{Binding ActionEditors}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              RowHeaderWidth="0"
                                              Height="170"
                                              BorderBrush="#E5E7EB"
                                              BorderThickness="1"
                                              Background="White"
                                              AlternatingRowBackground="#F9FAFB"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow">

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="actionId"
                                                                Width="120"
                                                                Binding="{Binding ActionId, UpdateSourceTrigger=PropertyChanged}" />

                                            <DataGridTextColumn Header="actionType"
                                                                Width="120"
                                                                Binding="{Binding ActionType, UpdateSourceTrigger=PropertyChanged}" />

                                            <DataGridTemplateColumn Header="blockingType"
                                                                    Width="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding BlockingType}"
                                                                   VerticalAlignment="Center"
                                                                   Padding="4,0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox
                                                            ItemsSource="{Binding DataContext.BlockingTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            SelectedItem="{Binding BlockingType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Header="描述"
                                                                Width="100"
                                                                Binding="{Binding ActionDescription, UpdateSourceTrigger=PropertyChanged}" />

                                            <DataGridTextColumn Header="参数Key"
                                                                Width="100"
                                                                Binding="{Binding ParameterKey, UpdateSourceTrigger=PropertyChanged}" />

                                            <DataGridTextColumn Header="参数Value"
                                                                Width="100"
                                                                Binding="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- actionStates -->
                            <Border Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10">

                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="actionStates 动作状态列表"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"
                                                   VerticalAlignment="Center" />

                                        <Button Grid.Column="1"
                                                Content="由actions生成"
                                                Width="100"
                                                Height="28"
                                                Margin="0,0,8,0"
                                                Click="GenerateActionStatesButton_Click" />

                                        <Button Grid.Column="2"
                                                Content="新增状态"
                                                Width="80"
                                                Height="28"
                                                Margin="0,0,8,0"
                                                Click="AddActionStateButton_Click" />

                                        <Button Grid.Column="3"
                                                Content="删除状态"
                                                Width="80"
                                                Height="28"
                                                Click="DeleteActionStateButton_Click" />
                                    </Grid>

                                    <DataGrid x:Name="ActionStateDataGrid"
                                              ItemsSource="{Binding ActionStateEditors}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              RowHeaderWidth="0"
                                              Height="190"
                                              BorderBrush="#E5E7EB"
                                              BorderThickness="1"
                                              Background="White"
                                              AlternatingRowBackground="#F9FAFB"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow">

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="actionId"
                                                                Width="180"
                                                                Binding="{Binding ActionId, UpdateSourceTrigger=PropertyChanged}" />

                                            <DataGridTextColumn Header="actionType"
                                                                Width="120"
                                                                Binding="{Binding ActionType, UpdateSourceTrigger=PropertyChanged}" />

                                            <DataGridTextColumn Header="描述"
                                                                Width="110"
                                                                Binding="{Binding ActionDescription, UpdateSourceTrigger=PropertyChanged}" />

                                            <DataGridTemplateColumn Header="状态"
                                                                    Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ActionStatus}"
                                                                   VerticalAlignment="Center"
                                                                   Padding="4,0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox
                                                            ItemsSource="{Binding DataContext.ActionStatusOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            SelectedItem="{Binding ActionStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Header="结果描述"
                                                                Width="*"
                                                                Binding="{Binding ResultDescription, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="12">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="保存修改"
                            Width="88"
                            Height="32"
                            Margin="0,0,8,0"
                            Background="#2563EB"
                            Foreground="White"
                            BorderBrush="#2563EB"
                            FontWeight="SemiBold"
                            Click="SaveButton_Click" />

                    <Button Content="取消"
                            Width="72"
                            Height="32"
                            Click="CancelButton_Click" />

                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>