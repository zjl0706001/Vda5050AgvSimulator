<Window x:Class="Vda5050AgvSimulator.Views.PlcConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC配置"
        Width="1220"
        Height="820"
        WindowStartupLocation="CenterScreen"
        Topmost="False"
        ShowInTaskbar="True"
        Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="NormalButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource NormalButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="PLC配置"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#111827" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="PLC列表"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button x:Name="ToggleAllPlcsButton"
                                    Content="全部启用"
                                    Style="{StaticResource NormalButtonStyle}"
                                    Click="ToggleAllPlcsButton_Click" />

                            <Button x:Name="AddPlcButton"
                                    Content="新增"
                                    Style="{StaticResource NormalButtonStyle}"
                                    Click="AddPlcButton_Click" />

                            <Button x:Name="RemovePlcButton"
                                    Content="删除"
                                    Style="{StaticResource NormalButtonStyle}"
                                    Click="RemovePlcButton_Click" />
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="PlcListDataGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding Plcs}"
                              SelectedItem="{Binding SelectedPlc, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              SelectionChanged="PlcListDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="启用"
                                                    Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsThreeState="False"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="PlcEnableCheckBox_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="ID"
                                                Width="60"
                                                Binding="{Binding PlcId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <DataGridTextColumn Header="名称"
                                                Width="80"
                                                Binding="{Binding PlcName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <DataGridTextColumn Header="IP"
                                                Width="120"
                                                Binding="{Binding IpAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               Text="提示：PLC启用、PLC自动写入启用、DB块自动写入启用、DB块规则引用启用、全局规则启用后，规则才会执行。"
                               Foreground="#6B7280"
                               FontSize="12"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="190" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="PLC详情"
                               Style="{StaticResource SectionTitleStyle}" />

                    <Border x:Name="PlcDetailEditPanel"
                            Grid.Row="1"
                            Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,10">
                        <Grid DataContext="{Binding SelectedPlc}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="PLC类型"
                                       Style="{StaticResource FormLabelStyle}" />

                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      Height="28"
                                      SelectedValue="{Binding PlcType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="S1200" />
                                <ComboBoxItem Content="S1500" />
                                <ComboBoxItem Content="S300" />
                                <ComboBoxItem Content="S400" />
                            </ComboBox>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Text="内部端口"
                                       Style="{StaticResource FormLabelStyle}" />

                            <TextBox Grid.Row="0"
                                     Grid.Column="3"
                                     Height="28"
                                     Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="4"
                                       Text="代理端口"
                                       Style="{StaticResource FormLabelStyle}" />

                            <TextBox Grid.Row="0"
                                     Grid.Column="5"
                                     Height="28"
                                     Text="{Binding ProxyPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />


                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Rack"
                                       Style="{StaticResource FormLabelStyle}" />

                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Height="28"
                                     Text="{Binding Rack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="Slot"
                                       Style="{StaticResource FormLabelStyle}" />

                            <TextBox Grid.Row="1"
                                     Grid.Column="3"
                                     Height="28"
                                     Text="{Binding Slot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="4"
                                       Text="轮询ms"
                                       Style="{StaticResource FormLabelStyle}" />

                            <TextBox Grid.Row="1"
                                     Grid.Column="5"
                                     Height="28"
                                     Text="{Binding PollIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="连接超时"
                                       Style="{StaticResource FormLabelStyle}" />

                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Height="28"
                                     Text="{Binding ConnectTimeOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="接收超时"
                                       Style="{StaticResource FormLabelStyle}" />

                            <TextBox Grid.Row="2"
                                     Grid.Column="3"
                                     Height="28"
                                     Text="{Binding ReceiveTimeOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="4"
                                       Text="自动写入"
                                       Style="{StaticResource FormLabelStyle}" />

                            <CheckBox Grid.Row="2"
                                      Grid.Column="5"
                                      Content="启用"
                                      IsChecked="{Binding AutoWriteEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border x:Name="DbBlockEditPanel"
                            Grid.Row="2"
                            Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="DB块配置"
                                           Style="{StaticResource SectionTitleStyle}" />

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <Button Content="新增DB块"
                                            Style="{StaticResource NormalButtonStyle}"
                                            Click="AddDbBlockButton_Click" />

                                    <Button Content="删除DB块"
                                            Style="{StaticResource NormalButtonStyle}"
                                            Click="RemoveDbBlockButton_Click" />

                                    <Button Content="添加默认DB"
                                            Style="{StaticResource NormalButtonStyle}"
                                            Click="AddDefaultDbBlocksButton_Click" />

                                    <Button Content="复位DB"
                                            Style="{StaticResource NormalButtonStyle}"
                                            Click="ResetDbBlockButton_Click" />

                                    <Button Content="复位配置"
                                            Style="{StaticResource NormalButtonStyle}"
                                            Click="OpenDbBlockResetConfigButton_Click" />
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding SelectedPlc.DbBlocks}"
                                      SelectedItem="{Binding SelectedDbBlock, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="启用"
                                                            Width="60"
                                                            Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <DataGridCheckBoxColumn Header="自动写入"
                                                            Width="80"
                                                            Binding="{Binding AutoWriteEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <DataGridTextColumn Header="DB块"
                                                        Width="80"
                                                        Binding="{Binding DbNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <DataGridTextColumn Header="长度"
                                                        Width="80"
                                                        Binding="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <DataGridTextColumn Header="名称"
                                                        Width="120"
                                                        Binding="{Binding BlockName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <DataGridTextColumn Header="备注"
                                                        Width="*"
                                                        Binding="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <!-- 新增：查看数据块所有 bit 位 -->
                                    <DataGridTemplateColumn Header="数据位"
                                                            Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="查看位值"
                                                        Padding="8,2"
                                                        HorizontalAlignment="Center"
                                                        IsEnabled="{Binding DataContext.CanViewDbBlockBits, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Click="ViewDbBlockBitsButton_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 新增：配置DB块协议看板 -->
                                    <DataGridTemplateColumn Header="协议看板"
                                                            Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="配置协议"
                                                        Padding="8,2"
                                                        HorizontalAlignment="Center"
                                                        Click="OpenProtocolBoardConfigButton_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Grid x:Name="AutoWriteRuleEditPanel"
                          Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="DB块触发器选择"
                                           Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                <Button Content="刷新全局规则"
                                        Style="{StaticResource NormalButtonStyle}"
                                        Click="RefreshGlobalRulesButton_Click" />

                                <Button Content="管理全局规则"
                                        Style="{StaticResource NormalButtonStyle}"
                                        Click="ManageGlobalAutoWriteRulesButton_Click" />

                                <Button Content="绑定选中规则"
                                        Style="{StaticResource NormalButtonStyle}"
                                        Click="BindSelectedGlobalRuleButton_Click" />

                                <Button Content="移除绑定"
                                        Style="{StaticResource NormalButtonStyle}"
                                        Click="RemoveSelectedRuleRefButton_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="全局规则库"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               Margin="0,0,0,4" />

                                    <DataGrid x:Name="GlobalAutoWriteRulesDataGrid"
                                              Grid.Row="1"
                                              ItemsSource="{Binding EnabledGlobalAutoWriteRules}"
                                              SelectedItem="{Binding SelectedGlobalRule, Mode=TwoWay}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              SelectionMode="Extended"
                                              SelectionUnit="FullRow"
                                              RowHeight="36"
                                              ColumnHeaderHeight="26">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="启用"
                                                                    Width="60"
                                                                    Binding="{Binding IsEnabled}" />

                                            <DataGridTextColumn Header="ID"
                                                                Width="60"
                                                                Binding="{Binding RuleId}" />

                                            <DataGridTextColumn Header="规则名称"
                                                                Width="120"
                                                                Binding="{Binding RuleName}" />


                                            <DataGridTextColumn Header="延时"
                                                                Width="60"
                                                                Binding="{Binding DelayTriggerSummary}" />

                                            <DataGridTextColumn Header="写入"
                                                                Width="60"
                                                                Binding="{Binding WriteItems.Count}" />

                                            <DataGridTextColumn Header="备注"
                                                                Width="*"
                                                                Binding="{Binding Remark}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="当前DB块已绑定规则"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               Margin="0,0,0,4" />

                                    <DataGrid x:Name="DbBlockRuleRefsDataGrid"
                                              Grid.Row="1"
                                              ItemsSource="{Binding SelectedDbBlock.AutoWriteRuleList}"
                                              SelectedItem="{Binding SelectedDbBlockRuleRef, Mode=TwoWay}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              HeadersVisibility="Column"
                                              SelectionMode="Extended"
                                              SelectionUnit="FullRow"
                                              RowHeight="36"
                                              ColumnHeaderHeight="26">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="启用"
                                                                    Width="60"
                                                                    Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <DataGridTextColumn Header="RuleId"
                                                                Width="60"
                                                                IsReadOnly="True"
                                                                Binding="{Binding RuleId}" />

                                            <DataGridTextColumn Header="规则名称"
                                                                Width="120"
                                                                IsReadOnly="True"
                                                                Binding="{Binding RuleName}" />

                                            <DataGridTextColumn Header="顺序"
                                                                Width="60"
                                                                Binding="{Binding SortIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <DataGridTextColumn Header="备注"
                                                                Width="*"
                                                                Binding="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8"
                Margin="0,8,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Ellipse x:Name="PlcServerStatusEllipse"
                             Width="9"
                             Height="9"
                             Fill="#EF4444"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />

                    <TextBlock x:Name="PlcServerStatusTextBlock"
                               Text="PLC模拟服务：未启动"
                               FontSize="12"
                               Foreground="#6B7280"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="PlcServerStatusHintTextBlock"
                               Text=""
                               FontSize="12"
                               Foreground="#9CA3AF"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">


                    <Button Content="保存配置"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveButton_Click" />

                    <Button Content="关闭"
                            Style="{StaticResource NormalButtonStyle}"
                            Click="CancelButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>