<UserControl x:Class="Vda5050AgvSimulator.Views.AgvListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:views="clr-namespace:Vda5050AgvSimulator.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:agv="clr-namespace:Vda5050AgvSimulator.Models.Agv"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=views:AgvListView}">

    <Border Padding="8"
            Background="Transparent">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部操作区 -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="32"
                        Margin="0,0,8,0"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="6"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchIdTextBox"
                                 Grid.Column="0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="8,0,4,0"
                                 hc:InfoElement.Placeholder="按AGV ID搜索"
                                 VerticalContentAlignment="Center"
                                 KeyDown="SearchIdTextBox_KeyDown"
                                 TextChanged="SearchIdTextBox_TextChanged" />

                        <Button
                            Grid.Column="1"
                            Content="🔍"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="#4B5563"
                            FontSize="14"
                            Cursor="Hand"
                            ToolTip="搜索"
                            Click="SearchButton_Click" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" />
                <Button x:Name="ToggleAllAgvOnlineButton"
                        Grid.Column="2"
                        Content="全部上线"
                        Height="32"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource ButtonPrimary}"
                        Click="ToggleAllAgvOnlineButton_Click" />
                <Button x:Name="AddAgvButton"
                        Grid.Column="3"
                        Content="添加AGV"
                        Height="32"
                        VerticalAlignment="Center"
                        Style="{StaticResource ButtonPrimary}"
                        Click="AddAgvButton_Click" />
            </Grid>

            <!-- AGV卡片列表 -->
            <ListBox x:Name="AgvCardListBox"
                     Grid.Row="1"
                     ItemsSource="{Binding AgvView}"
                     SelectedItem="{Binding SelectedAgv, Mode=TwoWay}"
                     SelectionChanged="AgvCardListBox_SelectionChanged"
                     BorderBrush="#E5E7EB"
                     BorderThickness="1"
                     Background="#F9FAFB"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.IsDeferredScrollingEnabled="False"
                     ScrollViewer.PanningMode="VerticalOnly"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLength="1"
                     VirtualizingPanel.CacheLengthUnit="Page"
                     SnapsToDevicePixels="True"
                     UseLayoutRounding="True"
                     PreviewMouseWheel="AgvCardListBox_PreviewMouseWheel">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel ToolTip="双击卡片可修改AGV参数"
                                                MouseLeftButtonDown="AgvCardBorder_MouseLeftButtonDown" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Setter Property="UseLayoutRounding" Value="True" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="agv:AgvModel">
                        <Border Margin="8,8,8,0"
                                Padding="10"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="12"
                                Cursor="Hand"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                MouseLeftButtonDown="AgvCardBorder_MouseLeftButtonDown">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 顶部：AGV ID + 在线状态 + 删除按钮 -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="AGV "
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#111827" />

                                        <TextBlock Text="{Binding DeviceID}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#2563EB" />
                                    </StackPanel>

                                    <!-- 在线状态 -->
                                    <Border Grid.Column="1"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F3F4F6" />
                                                <Setter Property="BorderBrush" Value="#D1D5DB" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OnlineStatus}" Value="1">
                                                        <Setter Property="Background" Value="#ECFDF5" />
                                                        <Setter Property="BorderBrush" Value="#BBF7D0" />
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding OnlineStatus}" Value="2">
                                                        <Setter Property="Background" Value="#FEF2F2" />
                                                        <Setter Property="BorderBrush" Value="#FECACA" />
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding OnlineStatus}" Value="0">
                                                        <Setter Property="Background" Value="#F3F4F6" />
                                                        <Setter Property="BorderBrush" Value="#D1D5DB" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold">

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="未知" />
                                                    <Setter Property="Foreground" Value="#6B7280" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OnlineStatus}" Value="1">
                                                            <Setter Property="Text" Value="在线" />
                                                            <Setter Property="Foreground" Value="#16A34A" />
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding OnlineStatus}" Value="2">
                                                            <Setter Property="Text" Value="离线" />
                                                            <Setter Property="Foreground" Value="#DC2626" />
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding OnlineStatus}" Value="0">
                                                            <Setter Property="Text" Value="未知" />
                                                            <Setter Property="Foreground" Value="#6B7280" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- 删除按钮 -->
                                    <Button Grid.Column="2"
                                            Content="删除"
                                            Width="48"
                                            Height="24"
                                            Padding="0"
                                            FontSize="12"
                                            Background="#FEF2F2"
                                            Foreground="#DC2626"
                                            BorderBrush="#FECACA"
                                            Cursor="Hand"
                                            ToolTip="删除当前AGV"
                                            Click="DeleteAgvButton_Click" />
                                </Grid>

                                <!-- 运行信息 -->
                                <Border Grid.Row="1"
                                        Margin="0,10,0,0"
                                        Padding="8"
                                        Background="#F9FAFB"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="0"
                                                    Orientation="Horizontal">
                                            <TextBlock Text="地标："
                                                       Foreground="#6B7280" />
                                            <TextBlock Text="{Binding PositionID}"
                                                       Foreground="#111827"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal">
                                            <TextBlock Text="电量："
                                                       Foreground="#6B7280" />
                                            <TextBlock Text="{Binding Equantity}"
                                                       Foreground="#111827"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="%"
                                                       Foreground="#111827"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="0"
                                                    Orientation="Horizontal">
                                            <TextBlock Text="状态："
                                                       Foreground="#6B7280" />
                                            <TextBlock Text="{Binding RunStatus}"
                                                       Foreground="#111827"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal">
                                            <TextBlock Text="角度："
                                                       Foreground="#6B7280" />
                                            <TextBlock Text="{Binding Angle}"
                                                       Foreground="#111827"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="°"
                                                       Foreground="#111827"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 坐标信息 -->
                                <Grid Grid.Row="2"
                                      Margin="0,8,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Padding="8,5"
                                            Background="#EFF6FF"
                                            BorderBrush="#DBEAFE"
                                            BorderThickness="1"
                                            CornerRadius="8">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="X："
                                                       Foreground="#2563EB" />
                                            <TextBlock Text="{Binding X}"
                                                       Foreground="#1E3A8A"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Padding="8,5"
                                            Background="#EFF6FF"
                                            BorderBrush="#DBEAFE"
                                            BorderThickness="1"
                                            CornerRadius="8">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Y："
                                                       Foreground="#2563EB" />
                                            <TextBlock Text="{Binding Y}"
                                                       Foreground="#1E3A8A"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 网络信息 -->
                                <Border Grid.Row="3"
                                        Margin="0,8,0,0"
                                        Padding="8,5"
                                        Background="#F9FAFB"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal">
                                            <TextBlock Text="本地："
                                                       Foreground="#6B7280" />
                                            <TextBlock Text="{Binding LocalIP}"
                                                       Foreground="#374151" />
                                            <TextBlock Text=":"
                                                       Foreground="#374151" />
                                            <TextBlock Text="{Binding LocalPort}"
                                                       Foreground="#374151" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="双击修改"
                                                   Foreground="#9CA3AF"
                                                   FontSize="12" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 统计信息 -->
            <Border Grid.Row="2"
                    Margin="0,10,0,0"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">

                <UniformGrid Columns="3">
                    <StackPanel>
                        <TextBlock Text="总数"
                                   Foreground="#6B7280"
                                   FontSize="12" />

                        <TextBlock x:Name="TotalCountTextBlock"
                                   Text="0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#1F2937" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="在线"
                                   Foreground="#6B7280"
                                   FontSize="12" />

                        <TextBlock x:Name="OnlineCountTextBlock"
                                   Text="0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#22C55E" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="离线"
                                   Foreground="#6B7280"
                                   FontSize="12" />

                        <TextBlock x:Name="OfflineCountTextBlock"
                                   Text="0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#EF4444" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- 添加AGV弹窗 -->
            <Popup Grid.Row="0" x:Name="AddAgvPopup"
                   IsOpen="False"
                   PlacementTarget="{Binding ElementName=AddAgvButton}"
                   Placement="Bottom"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   HorizontalOffset="-180"
                   VerticalOffset="10">

                <views:AddAgvPopupView x:Name="AddAgvPopupView"
                                       CloseRequested="AddAgvPopupView_CloseRequested"
                                       AddRequested="AddAgvPopupView_AddRequested"
                                       PopupDragDelta="AddAgvPopupView_PopupDragDelta" />
            </Popup>

            <!-- 修改AGV弹窗 -->
            <Popup Grid.Row="1" x:Name="EditAgvPopup"
                   IsOpen="False"
                   PlacementTarget="{Binding ElementName=AgvCardListBox}"
                   Placement="Center"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   HorizontalOffset="120"
                   VerticalOffset="0">

                <views:EditAgvPopupView x:Name="EditAgvPopupView"
                                        CloseRequested="EditAgvPopupView_CloseRequested"
                                        SaveRequested="EditAgvPopupView_SaveRequested"
                                        PopupDragDelta="EditAgvPopupView_PopupDragDelta" />
            </Popup>
        </Grid>
    </Border>
</UserControl>