<UserControl x:Class="Vda5050AgvSimulator.Views.AgvOperationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>

        <!-- ================= 文本样式 ================= -->
        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>

        <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="FieldValueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- ================= 按钮基础与分类样式 ================= -->
        <!-- 1. 标准按钮 (白底灰边) -->
        <Style x:Key="ButtonStandard" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. 主要按钮 (蓝色主色调，例如上线/启动) -->
        <Style x:Key="ButtonPrimary" TargetType="Button" BasedOn="{StaticResource ButtonStandard}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. 危险按钮 (红色警告，例如急停) -->
        <Style x:Key="ButtonDanger" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">

            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.03" BlurRadius="6" Direction="270" ShadowDepth="2" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题与状态徽章 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="当前选中AGV"
                               Style="{StaticResource SectionTitleTextStyle}"
                               VerticalAlignment="Center" />

                    <Border x:Name="SelectedStatusBorder"
                            Grid.Column="1"
                            Background="#F3F4F6"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4">
                        <TextBlock x:Name="SelectedStatusTextBlock"
                                   Text="未选择"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- 信息字段区域 -->
                <Border Grid.Row="1"
                        Background="#F9FAFB"
                        BorderBrush="#F3F4F6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>

                        <!-- Row 0 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="AGV ID:"
                                   Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock x:Name="SelectedAgvIdTextBlock" Grid.Row="0" Grid.Column="1" Text="未选择"
                                   Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="节点:" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock x:Name="SelectedPositionTextBlock" Grid.Row="0" Grid.Column="3" Text="-"
                                   Style="{StaticResource FieldValueTextStyle}" />

                        <!-- Row 1 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="状态:" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock x:Name="SelectedRunStatusTextBlock" Grid.Row="1" Grid.Column="1" Text="-"
                                   Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="电量:" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock x:Name="SelectedElectricTextBlock" Grid.Row="1" Grid.Column="3" Text="-"
                                   Style="{StaticResource FieldValueTextStyle}" Foreground="#059669" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= 模块二：选中AGV操作 ================= -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">

            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.03" BlurRadius="6" Direction="270" ShadowDepth="2" />
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="选中AGV操作"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,12" />

                    <!-- 在线控制 -->
                    <Grid Grid.Row="1"
                          Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="OnlineButton"
                                Grid.Column="0"
                                Content="上线"
                                Style="{StaticResource ButtonPrimary}"
                                MinWidth="0"
                                HorizontalContentAlignment="Center"
                                Click="OnlineButton_Click" />

                        <Button x:Name="OfflineButton"
                                Grid.Column="2"
                                Content="下线"
                                Style="{StaticResource ButtonStandard}"
                                MinWidth="0"
                                HorizontalContentAlignment="Center"
                                Click="OfflineButton_Click" />
                    </Grid>

                    <!-- 手自动控制 -->
                    <Grid Grid.Row="2"
                          Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ManualModeButton"
                                Grid.Column="0"
                                Content="手动"
                                Style="{StaticResource ButtonStandard}"
                                MinWidth="0"
                                HorizontalContentAlignment="Center"
                                Click="ManualModeButton_Click" />

                        <Button x:Name="AutomaticModeButton"
                                Grid.Column="2"
                                Content="自动"
                                Style="{StaticResource ButtonPrimary}"
                                MinWidth="0"
                                HorizontalContentAlignment="Center"
                                Click="AutomaticModeButton_Click" />
                    </Grid>

                    <!-- 运行控制 -->
                    <Grid Grid.Row="3"
                          Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="StartButton"
                                Grid.Row="0"
                                Grid.Column="0"
                                Content="启动"
                                Style="{StaticResource ButtonStandard}"
                                MinWidth="0"
                                HorizontalContentAlignment="Center"
                                Click="StartButton_Click" />

                        <Button x:Name="StopButton"
                                Grid.Row="0"
                                Grid.Column="2"
                                Content="停止"
                                Style="{StaticResource ButtonStandard}"
                                MinWidth="0"
                                HorizontalContentAlignment="Center"
                                Click="StopButton_Click" />

                        <Button x:Name="PreciseStopButton"
                                Grid.Row="2"
                                Grid.Column="0"
                                Content="精准停车"
                                Style="{StaticResource ButtonStandard}"
                                MinWidth="0"
                                HorizontalContentAlignment="Center"
                                Click="PreciseStopButton_Click" />

                        <Button x:Name="ResetButton"
                                Grid.Row="2"
                                Grid.Column="2"
                                Content="复位"
                                Style="{StaticResource ButtonStandard}"
                                MinWidth="0"
                                HorizontalContentAlignment="Center"
                                Click="ResetButton_Click" />
                    </Grid>

                    <!-- 异常控制 -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="EmergencyStopButton"
                                Grid.Column="0"
                                Content="急停"
                                Style="{StaticResource ButtonDanger}"
                                MinWidth="0"
                                Height="34"
                                HorizontalContentAlignment="Center"
                                Click="EmergencyStopButton_Click" />

                        <Button x:Name="ReleaseEmergencyStopButton"
                                Grid.Column="2"
                                Content="解除急停"
                                Style="{StaticResource ButtonStandard}"
                                MinWidth="0"
                                HorizontalContentAlignment="Center"
                                Click="ReleaseEmergencyStopButton_Click" />
                    </Grid>

                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>