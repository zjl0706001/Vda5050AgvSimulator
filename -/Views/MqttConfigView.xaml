<UserControl x:Class="Vda5050AgvSimulator.Views.MqttConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Vda5050AgvSimulator.Views">
    <Grid Margin="14,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="230" />
        </Grid.ColumnDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Column="0"
                    Orientation="Vertical"
                    VerticalAlignment="Center">
            <TextBlock Text="VDA5050 AGV模拟器"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#1F2937" />
            <TextBlock Text="Protocol Version 2.0.0"
                       FontSize="12"
                       Foreground="#6B7280"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- IP / 端口显示区：点击打开参数配置弹窗 -->
        <Border x:Name="BrokerInfoBorder"
                Grid.Column="1"
                Background="#F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                VerticalAlignment="Center"
                Cursor="Hand"
                MouseLeftButtonUp="BrokerInfoBorder_MouseLeftButtonUp">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="MQTT服务端"
                               FontSize="12"
                               Foreground="#6B7280" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <TextBlock x:Name="ServerIpTextBlock"
                                   Text="127.0.0.1"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1F2937" />

                        <TextBlock Text=":"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"
                                   Margin="4,0" />

                        <TextBlock x:Name="ServerPortTextBlock"
                                   Text="1883"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1F2937" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="配置"
                           FontSize="12"
                           Foreground="#2563EB"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- 连接/断开切换按钮 -->
        <Button x:Name="MqttConnectSwitchButton"
                Grid.Column="2"
                Content="连接"
                Width="96"
                Height="36"
                Margin="18,0,0,0"
                VerticalAlignment="Center"
                Background="#2563EB"
                Foreground="White"
                BorderBrush="#2563EB"
                FontWeight="SemiBold"
                Click="MqttConnectSwitchButton_Click" />

        <!-- 中间留白 -->
        <Border Grid.Column="3" />
        <Border Grid.Column="4"
                x:Name="PlcInfoBorder"
                Width="170"
                Height="64"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8"
                Margin="0,0,10,0"
                Cursor="Hand"
                MouseLeftButtonUp="PlcInfoBorder_MouseLeftButtonUp">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="PLC配置"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="点击配置"
                               FontSize="10"
                               Foreground="#2563EB"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="PlcStatusEllipse"
                             Grid.Column="0"
                             Width="7"
                             Height="7"
                             Fill="#EF4444"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0" />

                    <TextBlock x:Name="PlcConfigTextBlock"
                               Grid.Column="1"
                               Text="PLC: 未配置"
                               FontSize="10"
                               Foreground="#6B7280"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </Border>

        <!-- 右侧连接状态 -->
        <Border Grid.Column="5"
                Width="180"
                Height="52"
                VerticalAlignment="Center"
                Background="#F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="MqttStatusEllipse"
                         Grid.Column="0"
                         Width="10"
                         Height="10"
                         Fill="#EF4444"
                         VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="MqttStatusTextBlock"
                               Text="未连接"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#EF4444" />

                    <TextBlock x:Name="MqttBrokerTextBlock"
                               Text="Broker: 127.0.0.1:1883"
                               FontSize="10"
                               Foreground="#6B7280"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 参数配置弹窗 -->
        <Popup Grid.Column="0" x:Name="ConfigPopup"
               IsOpen="False"
               PlacementTarget="{Binding ElementName=BrokerInfoBorder}"
               Placement="Center"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               HorizontalOffset="0"
               VerticalOffset="10">

            <views:MqttParameterPopupView x:Name="MqttParameterPopup"
                                          CloseRequested="MqttParameterPopupView_CloseRequested"
                                          SaveRequested="MqttParameterPopupView_SaveRequested"
                                          PopupDragDelta="MqttParameterPopupView_PopupDragDelta" />

        </Popup>

    </Grid>
</UserControl>