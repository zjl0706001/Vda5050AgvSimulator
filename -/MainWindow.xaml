<Window x:Class="Vda5050AgvSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Vda5050AgvSimulator.Views"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="VDA5050 AGV 模拟器"
        Width="1500"
        Height="900"
        MinWidth="1200"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧 HandyControl SideMenu -->
        <hc:Card Grid.Column="0"
                 Padding="0"
                 Margin="0,0,12,0"
                 Background="White">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <Border Grid.Row="0"
                        Padding="16"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="AGV 模拟器"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#111827" />

                        <TextBlock Text="VDA5050 / MQTT / PLC"
                                   Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="#6B7280" />
                    </StackPanel>
                </Border>

                <!-- SideMenu 菜单 -->
                <hc:SideMenu x:Name="MainSideMenu"
                             Grid.Row="1"
                             BorderThickness="0"
                             AutoSelect="False"
                             ExpandMode="ShowOne"
                             SelectionChanged="MainSideMenu_SelectionChanged">

                    <hc:SideMenuItem Header="总览看板"
                                     Tag="Dashboard"
                                     IsSelected="True" />

                    <hc:SideMenuItem Header="AGV管理">
                        <hc:SideMenuItem Header="AGV列表"
                                         Tag="AgvList" />

                        <hc:SideMenuItem Header="地图监控"
                                         Tag="AgvMap" />

                        <hc:SideMenuItem Header="AGV操作"
                                         Tag="AgvOperation" />
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Header="订单">
                        <hc:SideMenuItem Header="订单信息"
                                         Tag="Order" />
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Header="MQTT">
                        <hc:SideMenuItem Header="MQTT配置"
                                         Tag="MqttConfig" />

                        <hc:SideMenuItem Header="消息监控"
                                         Tag="MessageMonitor" />
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Header="PLC">
                        <hc:SideMenuItem Header="PLC配置"
                                         Tag="PlcConfig" />
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Header="日志">
                        <hc:SideMenuItem Header="运行日志"
                                         Tag="Log" />
                    </hc:SideMenuItem>
                </hc:SideMenu>

                <!-- 底部说明 -->
                <Border Grid.Row="2"
                        Padding="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,1,0,0">
                    <TextBlock Text="SideMenu 导航版"
                               HorizontalAlignment="Center"
                               Foreground="#9CA3AF"
                               FontSize="12" />
                </Border>
            </Grid>
        </hc:Card>

        <!-- 右侧内容区域 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 页面标题 -->
            <hc:Card Grid.Row="0"
                     Margin="0,0,0,12"
                     Padding="16"
                     Background="White">
                <Grid>
                    <TextBlock x:Name="PageTitleTextBlock"
                               Text="总览看板"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#111827"
                               VerticalAlignment="Center" />
                </Grid>
            </hc:Card>

            <!-- 页面内容 -->
            <ContentControl x:Name="MainContentControl"
                            Grid.Row="1" />
        </Grid>
    </Grid>
</Window>