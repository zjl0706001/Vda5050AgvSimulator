<Window x:Class="Vda5050AgvSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Vda5050AgvSimulator.Views"
        Title="VDA5050 AGV 模拟器"
        Width="1340" Height="800" MinWidth="480" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        SizeChanged="MainWindow_SizeChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="#F0F0F0" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="72" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                        <Border Width="32" Height="32" CornerRadius="7" Background="#1677FF">
                            <Path Width="22" Height="22" Stretch="Uniform" Stroke="White"
                                  StrokeThickness="1.65" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M3,7 L5,4 H17 L20,7 V15 H3 Z M3,9 H20 M8,4 V9 M15,4 V9 M6,15 V17 H8 V15 M15,15 V17 H17 V15 M6,12 H8 M15,12 H17" />
                        </Border>
                        <StackPanel x:Name="ProductLabel" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="VDA 5050" FontSize="17" FontWeight="SemiBold" Foreground="#141414" />
                            <TextBlock Text="AGV 模拟器" FontSize="12" Foreground="#595959" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="ConnectionFooter" DockPanel.Dock="Bottom" BorderBrush="#F0F0F0"
                        BorderThickness="0,1,0,0" Padding="12,8">
                    <Button Click="OpenMqttPage" ToolTip="打开 MQTT 连接设置" Padding="6,4"
                            Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left">
                        <TextBlock Text="{Binding ConnectionStatus, StringFormat='MQTT  {0}'}"
                                   FontSize="12" Foreground="#595959" />
                    </Button>
                </Border>
                <views:WorkspaceMenu x:Name="NavigationMenu" Margin="6,12,6,0" />
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="20,0" MinHeight="72">
                <DockPanel LastChildFill="True">
                    <StackPanel x:Name="VehiclePicker" DockPanel.Dock="Right" Visibility="Collapsed"
                                Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="当前车辆" VerticalAlignment="Center" Foreground="#595959" Margin="0,0,8,0" />
                        <ComboBox x:Name="VehicleSelection" Width="108" MinHeight="32"
                                  AutomationProperties.Name="当前车辆" TextSearch.TextPath="DeviceID"
                                  SelectionChanged="VehicleSelection_Changed">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeviceID, StringFormat='AGV {0}'}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="PageTitle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="20" FontWeight="SemiBold" Foreground="#141414" />
                </DockPanel>
            </Border>
            <ContentControl x:Name="PageContent" Grid.Row="1" Margin="12" Focusable="False"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
