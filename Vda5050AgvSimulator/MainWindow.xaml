<Window x:Class="Vda5050AgvSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Vda5050AgvSimulator.Views"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="VDA5050 AGV 模拟器"
        Width="1340" Height="800" MinWidth="480" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#F2F5F9"
        FontFamily="Inter, Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="WorkspaceSurface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WorkspaceBorder" Color="#DCE4EE" />
        <SolidColorBrush x:Key="WorkspaceMuted" Color="#52637A" />
        <SolidColorBrush x:Key="WorkspaceAccent" Color="#225ADB" />

        <Style x:Key="WorkspaceTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource WorkspaceMuted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome" MinHeight="38" Margin="2"
                                Padding="8,5" CornerRadius="7"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#E5EDF9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="White" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="#D6E0F1" />
                                <Setter Property="Foreground" Value="{StaticResource WorkspaceAccent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource WorkspaceAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceTabsStyle" TargetType="TabControl">
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Margin="9,9,9,0" Padding="2" Background="#EAF0F8" CornerRadius="9">
                                <UniformGrid Rows="1" IsItemsHost="True"
                                             KeyboardNavigation.TabNavigation="Once"
                                             KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              Margin="0,1,0,0" ContentSource="SelectedContent"
                                              KeyboardNavigation.TabNavigation="Local" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="ShowsPreview" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}">
                            <Border x:Name="Grip" Width="2" Height="40" Background="#B6C5D8"
                                    CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ResizeDirection" Value="Rows">
                                <Setter TargetName="Grip" Property="Width" Value="40" />
                                <Setter TargetName="Grip" Property="Height" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{StaticResource WorkspaceAccent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{StaticResource WorkspaceAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="0,0,0,12" MinHeight="72" CornerRadius="11"
                Background="{StaticResource WorkspaceSurface}"
                BorderBrush="{StaticResource WorkspaceBorder}" BorderThickness="1">
            <views:MqttConfigView />
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" SizeChanged="WorkspaceGrid_SizeChanged" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FleetRow" Height="*" />
                <RowDefinition x:Name="SplitterRow" Height="0" />
                <RowDefinition x:Name="DetailsRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FleetColumn" Width="*" MinWidth="370" />
                <ColumnDefinition x:Name="SplitterColumn" Width="12" />
                <ColumnDefinition x:Name="DetailsColumn" Width="372" MinWidth="310" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <views:AgvListView />

            <GridSplitter x:Name="ColumnSplitter" Grid.Column="1" ResizeDirection="Columns"
                          Style="{StaticResource WorkspaceSplitterStyle}" Cursor="SizeWE"
                          AutomationProperties.Name="调整右侧面板宽度" />
            <GridSplitter x:Name="RowSplitter" Grid.Row="1" ResizeDirection="Rows" Visibility="Collapsed"
                          Style="{StaticResource WorkspaceSplitterStyle}" Cursor="SizeNS"
                          AutomationProperties.Name="调整上下区域高度" />

            <Border x:Name="DetailsPanel" Grid.Column="2" CornerRadius="11"
                    Background="{StaticResource WorkspaceSurface}"
                    BorderBrush="{StaticResource WorkspaceBorder}" BorderThickness="1">
                <TabControl Style="{StaticResource WorkspaceTabsStyle}">
                    <TabItem Header="AGV 操作" Style="{StaticResource WorkspaceTabItemStyle}">
                        <views:AgvOperationView />
                    </TabItem>
                    <TabItem Header="订单信息" Style="{StaticResource WorkspaceTabItemStyle}">
                        <views:OrderView />
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- 底部日志区 -->
