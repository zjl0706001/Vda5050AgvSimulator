<Window x:Class="Vda5050AgvSimulator.Views.PlcPointChangeMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="点位变化记录"
        Width="1050"
        Height="650"
        MinWidth="820"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#F3F4F6">
    <Window.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
        </Style>
        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <Style x:Key="PickerStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
        </Style>
        <Style x:Key="PointTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <Style x:Key="WatchGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF0F4" />
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB" />
            <Setter Property="RowHeight" Value="27" />
        </Style>
        <Style x:Key="GridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="1.15*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ToggleMonitorButton"
                            Content="开始监听"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ToggleMonitorButton_Click" />
                    <Button Content="日志目录"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="OpenLogDirectoryButton_Click" />
                    <Button x:Name="TopmostButton"
                            Content="置顶"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="TopmostButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="点位变化记录" FontSize="17" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBlock x:Name="MonitorStateText"
                               Text="已暂停"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#4B5563" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,3">
                        <TextBlock Text="PLC / DB" Style="{StaticResource InputLabelStyle}" />
                        <ComboBox x:Name="TargetPicker"
                                  Width="205"
                                  AutomationProperties.Name="PLC 和 DB"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}"
                                  Style="{StaticResource PickerStyle}"
                                  SelectionChanged="TargetPicker_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,3">
                        <TextBlock Text="协议点位" Style="{StaticResource InputLabelStyle}" />
                        <ComboBox x:Name="ProtocolPointPicker"
                                  Width="254"
                                  AutomationProperties.Name="从协议看板选点"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="选择协议点位可带入名称、地址和数据类型"
                                  Style="{StaticResource PickerStyle}"
                                  SelectionChanged="ProtocolPointPicker_SelectionChanged" />
                    </StackPanel>
                </WrapPanel>

                <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,3">
                        <TextBlock Text="名称" Style="{StaticResource InputLabelStyle}" />
                        <TextBox x:Name="PointNameBox"
                                 Width="114"
                                 AutomationProperties.Name="点位名称"
                                 Style="{StaticResource PointTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,3">
                        <TextBlock Text="地址" Style="{StaticResource InputLabelStyle}" />
                        <TextBox x:Name="PointAddressBox"
                                 Width="145"
                                 AutomationProperties.Name="点位地址"
                                 ToolTip="例如 DBX200.6、DBW4、DB1500.DBB8"
                                 Style="{StaticResource PointTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,3">
                        <TextBlock Text="类型" Style="{StaticResource InputLabelStyle}" />
                        <ComboBox x:Name="PointTypePicker"
                                  Width="108"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  AutomationProperties.Name="数据类型"
                                  Style="{StaticResource PickerStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <CheckBox x:Name="PointEnabledCheckBox"
                                  Content="启用"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="0,0,5,0" />
                        <Button x:Name="ApplyPointButton"
                                Content="添加点位"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ApplyPointButton_Click" />
                        <Button x:Name="NewPointButton"
                                Content="新建"
                                IsEnabled="False"
                                Style="{StaticResource ToolButtonStyle}"
                                Click="NewPointButton_Click" />
                        <Button x:Name="RemovePointButton"
                                Content="删除"
                                IsEnabled="False"
                                Style="{StaticResource ToolButtonStyle}"
                                Click="RemovePointButton_Click" />
                    </StackPanel>
                </WrapPanel>

                <DataGrid x:Name="WatchPointsGrid"
                          Grid.Row="2"
                          IsSynchronizedWithCurrentItem="False"
                          Style="{StaticResource WatchGridStyle}"
                          SelectionChanged="WatchPointsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PLC / DB" Width="150" Binding="{Binding Target}"
                                            ElementStyle="{StaticResource GridTextStyle}" />
                        <DataGridTextColumn Header="点位" Width="*" MinWidth="95" Binding="{Binding Name}"
                                            ElementStyle="{StaticResource GridTextStyle}" />
                        <DataGridTextColumn Header="地址" Width="140" Binding="{Binding Address}"
                                            ElementStyle="{StaticResource GridTextStyle}" />
                        <DataGridTextColumn Header="类型" Width="92" Binding="{Binding DataType}"
                                            ElementStyle="{StaticResource GridTextStyle}" />
                        <DataGridTextColumn Header="当前值" Width="120" Binding="{Binding CurrentValue}"
                                            ElementStyle="{StaticResource GridTextStyle}" />
                        <DataGridTextColumn Header="读取状态" Width="148" Binding="{Binding Status}"
                                            ElementStyle="{StaticResource GridTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PanelStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="变化记录"
                           Margin="0,0,0,7"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#111827" />
                <DataGrid x:Name="ChangesGrid" Style="{StaticResource WatchGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Width="140" Binding="{Binding TimeText}"
                                            ElementStyle="{StaticResource GridTextStyle}" />
                        <DataGridTextColumn Header="PLC / DB" Width="148" Binding="{Binding Target}"
                                            ElementStyle="{StaticResource GridTextStyle}" />
                        <DataGridTextColumn Header="点位" Width="120" Binding="{Binding Name}"
                                            ElementStyle="{StaticResource GridTextStyle}" />
                        <DataGridTextColumn Header="地址" Width="140" Binding="{Binding Address}"
                                            ElementStyle="{StaticResource GridTextStyle}" />
                        <DataGridTextColumn Header="旧值" Width="*" MinWidth="80" Binding="{Binding OldValueText}"
                                            ElementStyle="{StaticResource GridTextStyle}" />
                        <DataGridTextColumn Header="新值" Width="*" MinWidth="80" Binding="{Binding NewValueText}"
                                            ElementStyle="{StaticResource GridTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="4" Margin="2,7,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PointStatusText"
                       Foreground="#4B5563"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <TextBlock x:Name="LogStatusText"
                       Grid.Column="1"
                       Foreground="#4B5563"
                       TextAlignment="Right"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Grid>
    </Grid>
</Window>
