<Window x:Class="Vda5050AgvSimulator.Views.PlcPointChangeMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="点位变化记录"
        Width="1050"
        Height="650"
        MinWidth="820"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#F0F3F6"
        Foreground="#142740"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#142740" />
        <SolidColorBrush x:Key="Muted" Color="#4D5F76" />
        <SolidColorBrush x:Key="Line" Color="#D5DBE4" />
        <SolidColorBrush x:Key="Accent" Color="#235DB5" />
        <SolidColorBrush x:Key="AccentWash" Color="#E0E9F5" />
        <SolidColorBrush x:Key="Soft" Color="#F1F4F7" />

        <PathGeometry x:Key="PinIcon" Figures="M5,2.5 L12,2.5 M6,2.7 L6,6.7 L3.8,9.5 L3.8,10 L13.2,10 L13.2,9.5 L11,6.7 L11,2.7 M8.5,10 L8.5,15" />

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Heading}">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="DetailText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>

        <Style x:Key="ActionButton" TargetType="{x:Type ButtonBase}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C5CFDB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ButtonBase}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path x:Name="Glyph" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform"
                                      Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4F9" />
                    <Setter Property="BorderBrush" Value="#7E9ABE" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D4DFEE" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#083D82" />
                    <Setter Property="BorderBrush" Value="#083D82" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#07346F" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PinButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Tag" Value="{StaticResource PinIcon}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentWash}" />
                    <Setter Property="Foreground" Value="#083C80" />
                    <Setter Property="BorderBrush" Value="#7998C1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PickerItem" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentWash}" />
                    <Setter Property="Foreground" Value="#083E83" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#D6E0ED" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Picker" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="MaxDropDownHeight" Value="264" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="#BAC6D5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PickerItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="PickerRoot">
                            <ToggleButton Style="{x:Null}" Focusable="False" IsTabStop="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="6">
                                            <Path x:Name="Arrow" Data="M1,1 L5,5 L9,1" Stroke="#435771" StrokeThickness="1.5"
                                                  StrokeLineJoin="Round" Margin="0,0,10,0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M1,5 L5,1 L9,5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Selection" Margin="10,1,28,1" VerticalAlignment="Center"
                                              IsHitTestVisible="False" ClipToBounds="True"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <TextBlock x:Name="PickerHint" Visibility="Collapsed" Margin="10,1,28,1"
                                       IsHitTestVisible="False" Text="{TemplateBinding Tag}" Foreground="{StaticResource Muted}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="9,1,27,1"
                                     Style="{x:Null}" Background="Transparent" BorderThickness="0" Padding="0"
                                     VerticalContentAlignment="Center" Foreground="{TemplateBinding Foreground}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   PlacementTarget="{Binding ElementName=PickerRoot}" Placement="Bottom" VerticalOffset="3"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Width="{Binding ActualWidth, ElementName=PickerRoot}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Padding="3" Background="White" BorderBrush="#A6B3C3" BorderThickness="1" CornerRadius="6">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEditable" Value="False" />
                                    <Condition Property="SelectedIndex" Value="-1" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PickerHint" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter TargetName="Selection" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#718CAF" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="NamedChoice">
            <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <Style x:Key="TableHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#ECEFF4" />
            <Setter Property="Foreground" Value="#3D5068" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderBrush" Value="#D9DFE7" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style x:Key="TableCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DAE5F3" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#607FA8" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TableRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F8F9FA" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBF0F6" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DAE5F3" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MonitorTable" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E8ED" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="RowHeight" Value="31" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource TableHeader}" />
            <Setter Property="CellStyle" Value="{StaticResource TableCell}" />
            <Setter Property="RowStyle" Value="{StaticResource TableRow}" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="CodeText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="#2C425E" />
        </Style>
        <Style x:Key="EmptyText" TargetType="TextBlock" BasedOn="{StaticResource DetailText}">
            <Setter Property="Margin" Value="6,30,6,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="PaneDivider" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="KeyboardIncrement" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}">
                            <Border x:Name="Grip" Width="3" Height="32" CornerRadius="2"
                                    Background="#B7C2D1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ResizeDirection" Value="Rows">
                                <Setter TargetName="Grip" Property="Width" Value="36" />
                                <Setter TargetName="Grip" Property="Height" Value="3" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <PathGeometry x:Key="FolderIcon" Figures="M1.5,4 L6.4,4 L8,5.7 L14.4,5.7 L14.4,12.8 L1.5,12.8 Z" />
        <PathGeometry x:Key="PlayIcon" Figures="M4,2 L13,8 L4,14 Z" />
        <PathGeometry x:Key="PauseIcon" Figures="M5,2.5 L5,13.5 M11,2.5 L11,13.5" />
        <PathGeometry x:Key="UpIcon" Figures="M2,9 L7,4 L12,9" />
        <PathGeometry x:Key="DownIcon" Figures="M2,4 L7,9 L12,4" />
        <Style x:Key="ListenButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Tag" Value="{StaticResource PlayIcon}" />
            <Setter Property="MinWidth" Value="91" />
            <Style.Triggers>
                <Trigger Property="Content" Value="暂停">
                    <Setter Property="Tag" Value="{StaticResource PauseIcon}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ListenState" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="#ECEFF3" />
            <Setter Property="TextElement.Foreground" Value="#4E5E73" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content, ElementName=ToggleMonitorButton}" Value="暂停">
                    <Setter Property="Background" Value="{StaticResource AccentWash}" />
                    <Setter Property="TextElement.Foreground" Value="#093F85" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditorToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Content" Value="展开配置" />
            <Setter Property="Tag" Value="{StaticResource DownIcon}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="收起配置" />
                    <Setter Property="Tag" Value="{StaticResource UpIcon}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditorInput" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#BAC6D5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#718CAF" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EnableCheck" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1"
                                    Background="White" BorderBrush="#7C8DA3" VerticalAlignment="Center">
                                <Path x:Name="Tick" Visibility="Collapsed" Data="M1,5 L4,8 L10,1.5"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="White"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#132945" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LiveValueText" TargetType="TextBlock" BasedOn="{StaticResource CodeText}">
            <Setter Property="Foreground" Value="#09428C" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="Text" Value="—">
                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReadState" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <!-- 读取失败时文本附带设备消息，其余固定状态分别着色。 -->
            <Setter Property="Foreground" Value="#9A4034" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="正常">
                    <Setter Property="Foreground" Value="#09418A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="PLC未运行">
                    <Setter Property="Foreground" Value="#88580F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="已暂停">
                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="未启用">
                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="待采样">
                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="57" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1.28*" MinHeight="94" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelBorder}" Padding="13,10" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ToggleMonitorButton" Content="开始监听" Style="{StaticResource ListenButton}" Click="ToggleMonitorButton_Click" />
                    <Button Content="日志目录" Tag="{StaticResource FolderIcon}" Style="{StaticResource ActionButton}"
                            Margin="6,0,0,0" Click="OpenLogDirectoryButton_Click" />
                    <Button x:Name="TopmostButton" Content="置顶" Style="{StaticResource PinButton}"
                            Margin="6,0,0,0" Click="TopmostButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="#163E71" CornerRadius="8">
                        <Viewbox Width="23" Height="23">
                            <Canvas Width="24" Height="24">
                                <Path Data="M2,13 L6.5,13 L9.5,5 L13.5,19 L16.5,10 L19,13 L22,13"
                                      Stroke="#D7E5F8" StrokeThickness="1.8" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="点位变化记录" Margin="10,0,0,0" Style="{StaticResource Heading}" />
                    <Border Style="{StaticResource ListenState}" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                     Fill="{Binding Foreground, ElementName=MonitorStateText}" />
                            <TextBlock x:Name="MonitorStateText" Style="{x:Null}" Text="已暂停" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource PanelBorder}" />
        <Grid Grid.Row="1" Margin="13,8,13,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,7">
                <ToggleButton x:Name="EditorToggle" DockPanel.Dock="Right" IsChecked="True"
                              Style="{StaticResource EditorToggleStyle}" />
                <TextBlock DockPanel.Dock="Left" Text="监听点位" Style="{StaticResource SectionTitle}" />
                <TextBlock DockPanel.Dock="Left" Margin="8,0,0,0" Style="{StaticResource DetailText}"
                           Text="{Binding Items.Count, ElementName=WatchPointsGrid, StringFormat={}{0} 个}" />
                <TextBlock x:Name="PointStatusText" TextAlignment="Right" Margin="12,0" Style="{StaticResource DetailText}" />
            </DockPanel>
            <Border Grid.Row="1" Margin="0,0,0,8" Padding="9,7" CornerRadius="6" Background="{StaticResource Soft}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=EditorToggle}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.55*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label Content="PLC / DB" Target="{Binding ElementName=TargetPicker}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="TargetPicker" Grid.Column="1" Style="{StaticResource Picker}" Tag="选择 PLC / DB"
                                  AutomationProperties.Name="PLC 和 DB" ItemTemplate="{StaticResource NamedChoice}" TextSearch.TextPath="DisplayName"
                                  ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}"
                                  SelectionChanged="TargetPicker_SelectionChanged" />
                        <Label Grid.Column="2" Content="协议点位" Target="{Binding ElementName=ProtocolPointPicker}"
                               Style="{StaticResource FieldLabel}" Margin="14,0,7,0" />
                        <ComboBox x:Name="ProtocolPointPicker" Grid.Column="3" Style="{StaticResource Picker}" Tag="选择协议点位"
                                  AutomationProperties.Name="从协议看板选点" ItemTemplate="{StaticResource NamedChoice}" TextSearch.TextPath="DisplayName"
                                  ToolTip="从协议点位带入名称、地址和数据类型" SelectionChanged="ProtocolPointPicker_SelectionChanged" />
                        <CheckBox x:Name="PointEnabledCheckBox" Grid.Column="4" Content="启用点位" Style="{StaticResource EnableCheck}"
                                  IsChecked="True" Margin="16,0,3,0" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="0.8*" MinWidth="78" MaxWidth="152" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label Content="名称" Target="{Binding ElementName=PointNameBox}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PointNameBox" Grid.Column="1" AutomationProperties.Name="点位名称" Style="{StaticResource EditorInput}" />
                        <Label Grid.Column="2" Content="地址" Target="{Binding ElementName=PointAddressBox}"
                               Style="{StaticResource FieldLabel}" Margin="12,0,7,0" />
                        <TextBox x:Name="PointAddressBox" Grid.Column="3" AutomationProperties.Name="点位地址"
                                 FontFamily="Consolas, Microsoft YaHei UI" ToolTip="例如 DBX200.6、DBW4、DB1500.DBB8"
                                 Style="{StaticResource EditorInput}" />
                        <Label Grid.Column="4" Content="类型" Target="{Binding ElementName=PointTypePicker}"
                               Style="{StaticResource FieldLabel}" Margin="12,0,7,0" />
                        <ComboBox x:Name="PointTypePicker" Grid.Column="5" AutomationProperties.Name="数据类型"
                                  IsEditable="True" IsTextSearchEnabled="False" Style="{StaticResource Picker}" />
                        <StackPanel Grid.Column="6" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SavePointButton" Content="保存修改" IsEnabled="False" Style="{StaticResource ActionButton}" Click="SavePointButton_Click" />
                            <Button x:Name="RemovePointButton" Content="删除" IsEnabled="False" Margin="5,0,0,0"
                                    Foreground="#934238" Style="{StaticResource ActionButton}" Click="RemovePointButton_Click" />
                            <Button x:Name="AddPointButton" Content="添加点位" Margin="7,0,0,0"
                                    Style="{StaticResource PrimaryButton}" Click="AddPointButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="5,0,5,5">
            <DataGrid x:Name="WatchPointsGrid" Style="{StaticResource MonitorTable}" AutomationProperties.Name="监听点位列表"
                      IsSynchronizedWithCurrentItem="False" SelectionChanged="WatchPointsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PLC / DB" Width="1.15*" MinWidth="103" Binding="{Binding Target}" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="点位名称" Width="1.5*" MinWidth="97" Binding="{Binding Name}" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="地址" Width="1.2*" MinWidth="118" Binding="{Binding Address}" ElementStyle="{StaticResource CodeText}" />
                    <DataGridTextColumn Header="类型" Width="0.7*" MinWidth="62" Binding="{Binding DataType}" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="当前值" Width="1*" MinWidth="74" Binding="{Binding CurrentValue}" ElementStyle="{StaticResource LiveValueText}" />
                    <DataGridTextColumn Header="读取状态" Width="1.15*" MinWidth="90" Binding="{Binding Status}" ElementStyle="{StaticResource ReadState}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="暂无监听点位，可从协议中选择或手动添加">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=WatchPointsGrid}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <GridSplitter Grid.Row="3" Style="{StaticResource PaneDivider}" ResizeDirection="Rows"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      AutomationProperties.Name="调整监听点位与变化记录高度" ToolTip="拖动调整上下区域高度" />

        <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Padding="0,0,0,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="13,9">
                    <TextBlock DockPanel.Dock="Left" Text="变化记录" Style="{StaticResource SectionTitle}" />
                    <TextBlock DockPanel.Dock="Left" Margin="8,0,0,0" Style="{StaticResource DetailText}"
                               Text="{Binding Items.Count, ElementName=ChangesGrid, StringFormat={}{0} 条}" />
                    <CheckBox x:Name="SelectedOnlyCheckBox" DockPanel.Dock="Left" Content="只看选中点位"
                              Margin="16,0,0,0" Style="{StaticResource EnableCheck}" IsEnabled="False"
                              ToolTip="在上方选择监听点位，查看它的变化记录；取消勾选可查看全部。"
                              Click="SelectedOnlyCheckBox_Click" />
                    <TextBlock x:Name="LogStatusText" Margin="12,0,0,0" TextAlignment="Right" Style="{StaticResource DetailText}" />
                </DockPanel>
                <Grid Grid.Row="1" Margin="4,0">
                    <DataGrid x:Name="ChangesGrid" Style="{StaticResource MonitorTable}" AutomationProperties.Name="点位变化记录列表">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Width="1.05*" MinWidth="109" Binding="{Binding Record.TimeText}" ElementStyle="{StaticResource CodeText}" />
                            <DataGridTextColumn Header="PLC / DB" Width="1.1*" MinWidth="96" Binding="{Binding Record.Target}" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="点位名称" Width="1.4*" MinWidth="95" Binding="{Binding Record.Name}" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="地址" Width="1.2*" MinWidth="112" Binding="{Binding Record.Address}" ElementStyle="{StaticResource CodeText}" />
                            <DataGridTextColumn Header="旧值" Width="1*" MinWidth="61" Binding="{Binding Record.OldValueText}" ElementStyle="{StaticResource CodeText}" />
                            <DataGridTextColumn Header="新值" Width="1*" MinWidth="61" Binding="{Binding Record.NewValueText}" ElementStyle="{StaticResource LiveValueText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyText}">
                                <Setter Property="Text" Value="暂无变化记录，监听到数值变化后将显示在这里" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=SelectedOnlyCheckBox}" Value="True">
                                        <Setter Property="Text" Value="选中点位暂无变化记录" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=ChangesGrid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
