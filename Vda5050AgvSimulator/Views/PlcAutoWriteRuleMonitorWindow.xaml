<Window x:Class="Vda5050AgvSimulator.Views.PlcAutoWriteRuleMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="规则点位监视"
        Width="1240"
        Height="720"
        MinWidth="900"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#F3F4F6">
    <Window.Resources>
        <Style x:Key="MonitorButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="MonitorGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="ColumnHeaderHeight" Value="32" />
        </Style>
        <Style x:Key="MonitorTextCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Content="PLC / DB"
                           Target="{Binding ElementName=PlcTargetPicker}"
                           Foreground="#4B5563"
                           VerticalAlignment="Center" />
                    <ComboBox x:Name="PlcTargetPicker"
                              Width="192"
                              Height="32"
                              VerticalContentAlignment="Center"
                              IsSynchronizedWithCurrentItem="False"
                              ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}"
                              SelectionChanged="PlcTargetPicker_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                           ToolTip="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="刷新"
                            Style="{StaticResource MonitorButtonStyle}"
                            Click="RefreshButton_Click" />
                    <Button x:Name="TopmostButton"
                            Content="置顶"
                            Style="{StaticResource MonitorButtonStyle}"
                            Click="TopmostButton_Click" />
                    <Button Content="关闭"
                            Style="{StaticResource MonitorButtonStyle}"
                            Click="CloseButton_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="DbTitleText"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#111827"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Text="双击「当前值」切换 0 / 1。"
                               Margin="0,4,0,0"
                               Foreground="#4B5563" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="446" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="8">
                <DataGrid x:Name="RulesGrid"
                          Style="{StaticResource MonitorGridStyle}"
                          SelectionChanged="RulesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="顺序" Width="48" Binding="{Binding SortIndex}" />
                        <DataGridTextColumn Header="ID" Width="40" Binding="{Binding RuleId}" />
                        <DataGridTextColumn Header="规则" Width="*" Binding="{Binding Name}"
                                            ElementStyle="{StaticResource MonitorTextCellStyle}" />
                        <DataGridTextColumn Header="执行次数" Width="76"
                                            Binding="{Binding ExecutionCount, TargetNullValue=—}" />
                        <DataGridTemplateColumn Header="执行状态" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}"
                                               ToolTip="{Binding StatusDetail}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#4B5563" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExecuted}" Value="True">
                                                        <Setter Property="Foreground" Value="#047857" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SelectedRuleText"
                               Margin="4,2,4,8"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               TextTrimming="CharacterEllipsis" />
                    <DataGrid x:Name="PointsGrid" Grid.Row="1" Style="{StaticResource MonitorGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="类型" Width="105" Binding="{Binding Kind}"
                                                ElementStyle="{StaticResource MonitorTextCellStyle}" />
                            <DataGridTextColumn Header="点位名称" Width="*" MinWidth="100" Binding="{Binding Name}"
                                                ElementStyle="{StaticResource MonitorTextCellStyle}" />
                            <DataGridTextColumn Header="地址" Width="146" Binding="{Binding Address}"
                                                ElementStyle="{StaticResource MonitorTextCellStyle}" />
                            <DataGridTextColumn Header="条件 / 写入" Width="90" Binding="{Binding ExpectedValue}" />
                            <DataGridTextColumn Header="复位" Width="54" Binding="{Binding ResetValue}" />
                            <DataGridTemplateColumn Header="当前值" Width="76">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <EventSetter Event="PreviewMouseLeftButtonDown"
                                                     Handler="PointValueCell_PreviewMouseLeftButtonDown" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanToggle}" Value="True">
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="ToolTip" Value="双击取反" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CurrentValue}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#6B7280" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentValue}" Value="1">
                                                            <Setter Property="Foreground" Value="#2563EB" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="4,9,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ReadStatusText"
                       Foreground="#4B5563"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <TextBlock x:Name="EditStatusText"
                       Grid.Column="1"
                       TextAlignment="Right"
                       Foreground="#4B5563"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Grid>
    </Grid>
</Window>
