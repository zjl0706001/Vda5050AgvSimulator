<UserControl x:Class="Vda5050AgvSimulator.Views.MqttConfigView"
             x:Name="ConnectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Vda5050AgvSimulator.Views">
    <UserControl.Resources>
        <Style x:Key="BrokerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,3" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,3,8,3" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource WorkspaceInkBrush}" />
            <Setter Property="BorderBrush" Value="#C8D9DC" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource WorkspaceCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource WorkspaceAccentTintBrush}" BorderBrush="#C9E4E1" BorderThickness="1"
                CornerRadius="9" Padding="16,11" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" Margin="0,3,24,3">
                    <TextBlock Text="当前 MQTT 服务端" FontSize="12" Foreground="#456768" />
                    <TextBlock x:Name="MqttBrokerTextBlock" Margin="0,3,0,0" Foreground="{StaticResource WorkspaceInkBrush}"
                               FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                </StackPanel>
                <Border Background="White" CornerRadius="12" Padding="9,3"
                        VerticalAlignment="Center" Margin="0,3,20,3">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="MqttStatusEllipse" Width="7" Height="7" Margin="0,0,6,0" />
                        <TextBlock x:Name="MqttStatusTextBlock" FontWeight="SemiBold" FontSize="12"
                                   Text="{Binding ConnectionStatus, ElementName=ConnectionPage}" />
                    </StackPanel>
                </Border>
                <Button x:Name="MqttConnectSwitchButton" MinWidth="86" Style="{StaticResource BrokerButton}"
                        Background="{StaticResource WorkspaceAccentBrush}" BorderBrush="{StaticResource WorkspaceAccentBrush}" Foreground="White"
                        Click="MqttConnectSwitchButton_Click" />
                <Button x:Name="MosquittoServiceSwitchButton" Style="{StaticResource BrokerButton}"
                        Click="MosquittoServiceSwitchButton_Click" />
            </WrapPanel>
        </Border>

        <views:MqttParameterPopupView x:Name="ParameterEditor" Grid.Row="1"
                                      RevertRequested="RevertParameters"
                                      SaveRequested="SaveParameters" />
    </Grid>
</UserControl>
