<UserControl x:Class="Vda5050AgvSimulator.Views.MqttConfigView"
             x:Name="ConnectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Vda5050AgvSimulator.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="8" Padding="18,12" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,24,4">
                    <Ellipse x:Name="MqttStatusEllipse" Width="8" Height="8" Margin="0,0,8,0" />
                    <TextBlock x:Name="MqttStatusTextBlock" Text="{Binding ConnectionStatus, ElementName=ConnectionPage}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="MqttBrokerTextBlock" Margin="12,0,0,0"
                               Foreground="#595959" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="MqttConnectSwitchButton" Width="96" Height="32" Margin="0,2,8,2"
                        Click="MqttConnectSwitchButton_Click" />
                <Button x:Name="MosquittoServiceSwitchButton" MinWidth="120" Height="32" Margin="0,2"
                        Click="MosquittoServiceSwitchButton_Click" />
            </WrapPanel>
        </Border>

        <views:MqttParameterPopupView x:Name="ParameterEditor" Grid.Row="1"
                                      RevertRequested="RevertParameters"
                                      SaveRequested="SaveParameters" />
    </Grid>
</UserControl>
