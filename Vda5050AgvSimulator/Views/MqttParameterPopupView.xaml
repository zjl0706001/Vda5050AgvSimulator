<UserControl x:Class="Vda5050AgvSimulator.Views.MqttParameterPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mqtt="clr-namespace:Vda5050AgvSimulator.Models.Mqtt"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=mqtt:MqttConfigModel, IsDesignTimeCreatable=True}">

    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel x:Name="ParameterFields" MinWidth="560" Margin="20,16">
                    <!-- 基础连接 -->
                    <TextBlock Text="基础连接"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="服务端IP：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <TextBox Grid.Row="0" Grid.Column="1" Height="30"
                                 Text="{Binding ServerIp, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="服务端端口：" VerticalAlignment="Center"
                                   Margin="18,0,0,0" Foreground="#4B5563" />
                        <TextBox Grid.Row="0" Grid.Column="3" Height="30"
                                 Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="用户名：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <TextBox Grid.Row="1" Grid.Column="1" Height="30"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="密码：" VerticalAlignment="Center" Margin="18,0,0,0"
                                   Foreground="#4B5563" />
                        <PasswordBox x:Name="BrokerPassword" Grid.Row="1" Grid.Column="3" Height="30"
                                 PasswordChanged="BrokerPassword_Changed"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="客户端ID：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <TextBox Grid.Row="2" Grid.Column="1" Height="30"
                                 Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="心跳秒数：" VerticalAlignment="Center"
                                   Margin="18,0,0,0" Foreground="#4B5563" />
                        <TextBox Grid.Row="2" Grid.Column="3" Height="30"
                                 Text="{Binding KeepAliveSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="自动重连：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <CheckBox Grid.Row="3" Grid.Column="1"
                                  IsChecked="{Binding AutoReconnect, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <!-- VDA5050 参数 -->
                    <TextBlock Text="VDA5050 参数"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="接口名称：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <TextBox Grid.Row="0" Grid.Column="1" Height="30"
                                 Text="{Binding InterfaceName, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="协议版本：" VerticalAlignment="Center"
                                   Margin="18,0,0,0" Foreground="#4B5563" />
                        <TextBox Grid.Row="0" Grid.Column="3" Height="30"
                                 Text="{Binding ProtocolVersion, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="制造商：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <TextBox Grid.Row="1" Grid.Column="1" Height="30"
                                 Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="地图ID：" VerticalAlignment="Center"
                                   Margin="18,0,0,0" Foreground="#4B5563" />
                        <TextBox Grid.Row="1" Grid.Column="3" Height="30"
                                 Text="{Binding MapId, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="区域ID：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <TextBox Grid.Row="2" Grid.Column="1" Height="30"
                                 Text="{Binding ZoneId, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />
                    </Grid>

                    <!-- Topic 配置 -->
                    <TextBlock Text="Topic 配置"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="OrderTopic：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <TextBox Grid.Row="0" Grid.Column="1" Height="30"
                                 Text="{Binding OrderSubscribeTopic, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="instantActionsTopic：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <TextBox Grid.Row="1" Grid.Column="1" Height="30"
                                 Text="{Binding InstantActionsSubscribeTopic, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="FactSheetTopic：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <TextBox Grid.Row="2" Grid.Column="1" Height="30"
                                 Text="{Binding FactSheetPublishTopic, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="StateTopic：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <TextBox Grid.Row="3" Grid.Column="1" Height="30"
                                 Text="{Binding StatePublishTopic, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="VisualizationTopic：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <TextBox Grid.Row="4" Grid.Column="1" Height="30"
                                 Text="{Binding VisualizationPublishTopic, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="ConnectionTopic：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <TextBox Grid.Row="5" Grid.Column="1" Height="30"
                                 Text="{Binding ConnectionPublishTopic, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                    </Grid>

                    <!-- 发布参数 -->
                    <TextBlock Text="发布参数"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="State周期ms：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <TextBox Grid.Row="0" Grid.Column="1" Height="30"
                                 Text="{Binding StatePublishIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Visualization周期ms：" VerticalAlignment="Center"
                                   Margin="18,0,0,0" Foreground="#4B5563" />
                        <TextBox Grid.Row="0" Grid.Column="3" Height="30"
                                 Text="{Binding VisualizationPublishIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Connection周期ms：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <TextBox Grid.Row="1" Grid.Column="1" Height="30"
                                 Text="{Binding ConnectionPublishIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="QoS：" VerticalAlignment="Center"
                                   Margin="18,0,0,0" Foreground="#4B5563" />
                        <TextBox Grid.Row="1" Grid.Column="3" Height="30"
                                 Text="{Binding Qos, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <CheckBox Grid.Row="2" Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  Content="Retain State"
                                  IsChecked="{Binding RetainState, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center" />

                        <CheckBox Grid.Row="2" Grid.Column="2"
                                  Grid.ColumnSpan="2"
                                  Content="Retain Visualization"
                                  Margin="18,0,0,0"
                                  IsChecked="{Binding RetainVisualization, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center" />

                        <CheckBox Grid.Row="3" Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  Content="Retain Connection"
                                  IsChecked="{Binding RetainConnection, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center" />

                        <CheckBox Grid.Row="3" Grid.Column="2"
                                  Grid.ColumnSpan="2"
                                  Content="Retain FactSheet"
                                  Margin="18,0,0,0"
                                  IsChecked="{Binding RetainFactSheet, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center" />
                    </Grid>
                    <!-- FactSheet 参数 -->
                    <TextBlock Text="FactSheet 参数"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,18,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="AgvKinematic：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <TextBox Grid.Row="0" Grid.Column="1" Height="30"
                                 Text="{Binding FactSheetConfig.AgvKinematic, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="AgvClass：" VerticalAlignment="Center"
                                   Margin="18,0,0,0" Foreground="#4B5563" />
                        <TextBox Grid.Row="0" Grid.Column="3" Height="30"
                                 Text="{Binding FactSheetConfig.AgvClass, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="MaxLoadMass：" VerticalAlignment="Center"
                                   Foreground="#4B5563" />
                        <TextBox Grid.Row="1" Grid.Column="1" Height="30"
                                 Text="{Binding FactSheetConfig.MaxLoadMass, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />

                        <CheckBox Grid.Row="1" Grid.Column="2"
                                  Grid.ColumnSpan="2"
                                  Content="AGV上线后发布FactSheet"
                                  Margin="18,0,0,0"
                                  IsChecked="{Binding PublishFactSheetOnOnline, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 参数操作 -->
            <Border Grid.Row="1"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10"
                    Padding="12">

                <WrapPanel x:Name="ParameterActions" HorizontalAlignment="Right">

                    <Button Content="恢复默认"
                            Width="88"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="RestoreDefaultButton_Click" />

                    <Button x:Name="TestConnectionButton"
                            Content="测试连接"
                            Width="88"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="TestConnectionButton_Click" />

                    <Button Content="保存配置"
                            Width="88"
                            Height="32"
                            Margin="0,0,8,0"
                            Background="#1677FF"
                            Foreground="White"
                            BorderBrush="#1677FF"
                            Click="SaveButton_Click" />

                    <Button Content="撤销修改"
                            MinWidth="88"
                            Height="32"
                            Click="CancelButton_Click" />

                </WrapPanel>
            </Border>

            <!-- 操作反馈 -->
            <ScrollViewer Grid.RowSpan="2"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          IsHitTestVisible="False"
                          Margin="0,12,12,0">

                <StackPanel hc:Growl.Token="MqttConfigGrowl"
                            Width="360" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>