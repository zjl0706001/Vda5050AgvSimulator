<Window x:Class="Vda5050AgvSimulator.Views.PlcProtocolTemplateImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="共享协议" Width="820" Height="570" MinWidth="540" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#1F3552" Background="#F2F6FC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <ComboBox x:Name="DirectionBox" DockPanel.Dock="Right" MinWidth="126" MinHeight="32"
                      VerticalContentAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="通信方向">
                <ComboBoxItem Content="全部方向" />
                <ComboBoxItem Content="AGV → PLC" />
                <ComboBoxItem Content="PLC → AGV" />
            </ComboBox>
            <StackPanel>
                <TextBlock Text="工站共享协议" FontSize="20" FontWeight="SemiBold" Foreground="#15457C" />
                <TextBlock Text="所有 PLC 和 DB 块共用此表，读写时按当前目标解析偏移。" Margin="0,3,12,0"
                           Foreground="#4F6681" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD9E9" BorderThickness="1" CornerRadius="6" Padding="2">
            <DataGrid x:Name="SignalsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                      HeadersVisibility="Column" BorderThickness="0" Background="White" AlternatingRowBackground="#F4F8FE"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2EAF5" RowHeight="30" ColumnHeaderHeight="32">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="信号" Binding="{Binding Name}" Width="1.5*" MinWidth="120" />
                    <DataGridTextColumn Header="块内偏移" Binding="{Binding RelativeAddress}" Width="100" />
                    <DataGridTextColumn Header="数据类型" Binding="{Binding DataType}" Width="90" />
                    <DataGridTextColumn Header="说明" Binding="{Binding Remark}" Width="2*" MinWidth="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <DockPanel Grid.Row="2" Margin="2,10,0,0">
            <Button DockPanel.Dock="Right" Content="关闭" IsCancel="True" Padding="18,5" MinHeight="30" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="#4F6681" />
        </DockPanel>
    </Grid>
</Window>
