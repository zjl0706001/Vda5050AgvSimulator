<UserControl x:Class="Vda5050AgvSimulator.Views.OrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Inter, Segoe UI, Microsoft YaHei UI" FontSize="13"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="OrderText" Color="#1F1F1F" />
        <SolidColorBrush x:Key="OrderMuted" Color="#595959" />
        <SolidColorBrush x:Key="OrderAccent" Color="#1677FF" />
        <SolidColorBrush x:Key="OrderLine" Color="#E5E7EB" />
        <SolidColorBrush x:Key="OrderWarning" Color="#993B35" />

        <Style x:Key="OrderSection" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource OrderLine}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style x:Key="OrderSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource OrderText}" />
        </Style>
        <Style x:Key="OrderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource OrderMuted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="OrderField" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource OrderText}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="OrderDetailRow" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="OrderStatusFill" TargetType="Border">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#E9EFF7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Active">
                    <Setter Property="Background" Value="#E1ECFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Paused">
                    <Setter Property="Background" Value="#FFF0DB" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Done">
                    <Setter Property="Background" Value="#E3F3EB" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Error">
                    <Setter Property="Background" Value="#FBE8E4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OrderStatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource OrderMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Active">
                    <Setter Property="Foreground" Value="{StaticResource OrderAccent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Paused">
                    <Setter Property="Foreground" Value="#805415" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Done">
                    <Setter Property="Foreground" Value="#126549" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource OrderWarning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OrderCopyButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D3E0F4" />
            <Setter Property="Foreground" Value="{StaticResource OrderAccent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CopyChrome" Padding="{TemplateBinding Padding}" CornerRadius="6"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CopyChrome" Property="Background" Value="#E7F0FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CopyChrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False" PanningMode="VerticalOnly">
        <StackPanel Margin="2" MaxWidth="1250">
            <Border x:Name="EmptyOrderPanel" Style="{StaticResource OrderSection}"
                    Padding="16,32">
                <TextBlock x:Name="EmptyOrderTextBlock" Text="选择一台 AGV 查看订单"
                           HorizontalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource OrderMuted}" />
            </Border>

            <StackPanel x:Name="OrderContentPanel" Visibility="Collapsed">
                <Border Style="{StaticResource OrderSection}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding VehicleLabel}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource OrderText}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource OrderStatusFill}"
                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource OrderStatusText}" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="订单号" Style="{StaticResource OrderLabel}" />
                                <TextBlock Text="{Binding OrderId, TargetNullValue=—}"
                                           Style="{StaticResource OrderField}" ToolTip="{Binding OrderId}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="复制" VerticalAlignment="Center"
                                    Style="{StaticResource OrderCopyButton}" IsEnabled="{Binding HasOrder}"
                                    ToolTip="复制订单号" AutomationProperties.Name="复制订单号"
                                    Click="CopyOrderIdButton_Click" />
                        </Grid>

                        <UniformGrid x:Name="OrderMetrics" Columns="2" Margin="0,12,0,0">
                            <StackPanel Margin="0,0,6,5">
                                <TextBlock Text="更新序号" Style="{StaticResource OrderLabel}" />
                                <TextBlock Text="{Binding UpdateIdText}" Style="{StaticResource OrderField}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,5">
                                <TextBlock Text="最后地标" Style="{StaticResource OrderLabel}" />
                                <TextBlock Text="{Binding LastNodeText}" Style="{StaticResource OrderField}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="已到节点序号" Style="{StaticResource OrderLabel}" />
                                <TextBlock Text="{Binding LastSequenceText}" Style="{StaticResource OrderField}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="目标节点" Style="{StaticResource OrderLabel}" />
                                <TextBlock Text="{Binding TargetNodeText}" ToolTip="{Binding TargetNodeText}"
                                           Style="{StaticResource OrderField}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <DockPanel SizeChanged="DetailsPanel_SizeChanged">
                    <Border x:Name="RoutePanel" Style="{StaticResource OrderSection}" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="路线进度" Style="{StaticResource OrderSectionTitle}" />
                                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Margin="6,0,0,0"
                                           Style="{StaticResource OrderLabel}" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="{Binding TotalNodes}" Value="{Binding ReachedNodes, Mode=OneWay}"
                                         Height="5" Margin="0,7,0,0" BorderThickness="0" Focusable="False"
                                         Foreground="{StaticResource OrderAccent}" Background="#E0E9F6"
                                         AutomationProperties.Name="路线进度">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2">
                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2"
                                                    Background="{TemplateBinding Foreground}" />
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>

                            <TextBlock Text="{Binding RemainingNodesText}" Style="{StaticResource OrderLabel}" Margin="0,8,0,5" />
                            <ItemsControl x:Name="RouteNodesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource OrderDetailRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding NodeId}" ToolTip="{Binding NodeId}"
                                                           VerticalAlignment="Center" Style="{StaticResource OrderField}" />
                                                <TextBlock Grid.Column="1" Text="{Binding NodeHint}"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Style="{StaticResource OrderLabel}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="MoreNodesTextBlock" Margin="1,0,0,0" Visibility="Collapsed"
                                       Style="{StaticResource OrderLabel}" />
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <Border Style="{StaticResource OrderSection}">
                            <StackPanel>
                                <TextBlock Text="动作状态" Style="{StaticResource OrderSectionTitle}" />
                                <TextBlock Text="暂无动作" Foreground="{StaticResource OrderMuted}" Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=OrderActionsItemsControl}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl x:Name="OrderActionsItemsControl" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource OrderDetailRow}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding ActionType}" ToolTip="{Binding ActionType}"
                                                                   Style="{StaticResource OrderField}" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Margin="6,0,0,0"
                                                                Style="{StaticResource OrderStatusFill}">
                                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource OrderStatusText}"
                                                                       ToolTip="{Binding StatusCode}" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ActionIdLabel}" ToolTip="{Binding ActionId}"
                                                               Style="{StaticResource OrderLabel}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{StaticResource OrderMuted}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Margin" Value="0,3,0,0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Description}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border x:Name="WarningsPanel" Style="{StaticResource OrderSection}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="协议告警" Style="{StaticResource OrderSectionTitle}" />
                                <ItemsControl x:Name="OrderWarningsItemsControl" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource OrderDetailRow}" Background="#FCF2EF">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                               Foreground="{StaticResource OrderWarning}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{StaticResource OrderMuted}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
