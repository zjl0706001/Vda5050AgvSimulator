<Window x:Class="Vda5050AgvSimulator.Views.PlcConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:plc="clr-namespace:Vda5050AgvSimulator.Models.Plc"
        xmlns:views="clr-namespace:Vda5050AgvSimulator.Views"
        Title="PLC 配置"
        Width="1320"
        Height="840"
        MinWidth="1060"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Topmost="False"
        ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Foreground="#172B4D"
        Background="#F2F5FA">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE5F0" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#536580" />
        <SolidColorBrush x:Key="AccentBrush" Color="#245EDB" />
        <SolidColorBrush x:Key="SectionSurfaceBrush" Color="#F5F8FC" />
        <views:PlcConnectionCountConverter x:Key="PlcConnectionCountConverter" />
        <!-- 全局规则是规则引用启用权限的最高级开关。 -->
        <views:PlcGlobalRuleEnabledConverter x:Key="PlcGlobalRuleEnabledConverter" />
        <Style x:Key="RuleEnabledSwitchStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="36" Height="20" Padding="2"
                                BorderBrush="#B8C8DA" BorderThickness="1"
                                Background="#D3DEEB" CornerRadius="10">
                            <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7"
                                    Background="White" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#17479E" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#173E86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GloballyGatedRuleCheckBoxStyle" TargetType="CheckBox"
               BasedOn="{StaticResource RuleEnabledSwitchStyle}">
            <Style.Triggers>
                <DataTrigger Value="False">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource PlcGlobalRuleEnabledConverter}">
                            <Binding Path="RuleId" />
                            <Binding Path="DataContext.GlobalRuleEnabledStates"
                                     RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="PageCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#EEF3F8" />
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.Resources>
                                <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="1" />
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Value="{Binding Value, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreasePageButton"
                                                  Style="{StaticResource ScrollPageButtonStyle}"
                                                  Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ScrollThumb" Background="#AABBD0"
                                                        CornerRadius="4" Margin="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ScrollThumb" Property="Background"
                                                                Value="#839AB6" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ScrollThumb" Property="Background"
                                                                Value="#5C7698" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreasePageButton"
                                                  Style="{StaticResource ScrollPageButtonStyle}"
                                                  Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="DecreasePageButton" Property="Command"
                                        Value="{x:Static ScrollBar.PageLeftCommand}" />
                                <Setter TargetName="IncreasePageButton" Property="Command"
                                        Value="{x:Static ScrollBar.PageRightCommand}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Track" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="MinHeight" Value="12" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlcTextInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#AEBFD4" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Background" Value="#F3F6FA" />
                                <Setter TargetName="InputBorder" Property="BorderBrush"
                                        Value="{StaticResource PanelBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlcComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#172B4D" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="OptionBackground" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="OptionBackground" Property="Background" Value="#F0F5FC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="OptionBackground" Property="Background" Value="#E5EEFF" />
                                <Setter Property="Foreground" Value="#204FAE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlcComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Width" Value="100" />
            <Setter Property="Padding" Value="11,0,32,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#172B4D" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MaxDropDownHeight" Value="280" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PlcComboItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="DropDownToggle"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Focusable="False"
                                          IsTabStop="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="7">
                                            <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#536580" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,13,0" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="White" CornerRadius="8" Padding="4" Margin="0,4,0,0"
                                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="#AEBFD4" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DropDownToggle" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="DropDownToggle" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DropDownToggle" Property="Background" Value="#F3F6FA" />
                                <Setter TargetName="DropDownToggle" Property="BorderBrush"
                                        Value="{StaticResource PanelBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NormalButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#253B5B" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <Border x:Name="HoverLayer" CornerRadius="7" Background="#0D172B4D"
                                    Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverLayer" Property="Background" Value="#1F172B4D" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NormalButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource NormalButtonStyle}">
            <Setter Property="Foreground" Value="#204FAE" />
            <Setter Property="Background" Value="#EAF2FF" />
            <Setter Property="BorderBrush" Value="#C5D8FA" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MaintenanceButtonStyle" TargetType="Button" BasedOn="{StaticResource NormalButtonStyle}">
            <Setter Property="Foreground" Value="#9A3741" />
        </Style>

        <Style x:Key="TableActionStyle" TargetType="Button" BasedOn="{StaticResource NormalButtonStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="6,0" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="40" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFD" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EAF0F7" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF3FA" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8F0FF" />
                    <Setter Property="Foreground" Value="#173E86" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlcListTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,4,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="BatchIpv4TableStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="RowHeight" Value="40" />
            <Setter Property="ColumnHeaderHeight" Value="37" />
            <Setter Property="AlternatingRowBackground" Value="#F7F9FD" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E9EFF7" />
        </Style>

        <Style x:Key="BatchIpv4HeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="BatchIpv4ValueStyle" TargetType="TextBlock" BasedOn="{StaticResource PlcListTextStyle}">
            <Setter Property="Margin" Value="12,0,6,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style x:Key="BatchIpv4AddressStyle" TargetType="TextBlock" BasedOn="{StaticResource BatchIpv4ValueStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="BatchIpv4MaskStyle" TargetType="TextBlock" BasedOn="{StaticResource BatchIpv4ValueStyle}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>

        <Style x:Key="PlcEndpointTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PlcListTextStyle}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style x:Key="PlcTabsStyle" TargetType="TabControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource SectionSurfaceBrush}" CornerRadius="8" Padding="4">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" Margin="0,16,0,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              ContentSource="SelectedContent" KeyboardNavigation.TabIndex="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlcTabStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="17,9" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" CornerRadius="6"
                                BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#EAF0F8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White" />
                                <Setter TargetName="TabBorder" Property="BorderBrush"
                                        Value="{StaticResource PanelBorderBrush}" />
                                <Setter Property="Foreground" Value="#204FAE" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormSectionStyle" TargetType="Border" BasedOn="{StaticResource PageCardStyle}">
            <Setter Property="Background" Value="{StaticResource SectionSurfaceBrush}" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="TableFrameStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PlcEditableFieldsStyle" TargetType="Panel">
            <Setter Property="DataContext" Value="{Binding SelectedPlc}" />
            <Setter Property="IsEnabled"
                    Value="{Binding DataContext.CanEditSelectedPlc, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>

        <Style x:Key="PlcPortProxyFieldsStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectionMode}" Value="{x:Static plc:PlcConnectionMode.PortProxy}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlcDirectFieldsStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectionMode}" Value="{x:Static plc:PlcConnectionMode.Direct}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 批量启停专用样式：仅作用于三个规则菜单，不影响其它右键菜单。 -->
        <Style x:Key="BatchActionButtonStyle" TargetType="Button" BasedOn="{StaticResource NormalButtonStyle}">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0,9,0" />
            <Setter Property="Foreground" Value="#244A88" />
            <Setter Property="Background" Value="#F3F7FF" />
            <Setter Property="BorderBrush" Value="#C9D9F1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BatchButtonBorder" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                                <Path Grid.Column="1" Data="M 1,2 L 5,6 L 9,2"
                                      Stroke="#55739F" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Margin="10,0,0,0" Width="10" Height="8"
                                      Stretch="Uniform" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BatchButtonBorder" Property="Background" Value="#EAF2FF" />
                                <Setter TargetName="BatchButtonBorder" Property="BorderBrush" Value="#9DBBE9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BatchButtonBorder" Property="Background" Value="#DCEAFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BatchButtonBorder" Property="BorderBrush" Value="#245EDB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BatchButtonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ContextMenu 默认系统外观在不同 Windows 主题下不统一；使用统一圆角卡片。 -->
        <Style x:Key="BatchActionContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Width" Value="256" />
            <Setter Property="Background" Value="White" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border x:Name="BatchMenuSurface" CornerRadius="12"
                                Background="#FFFFFF" BorderBrush="#D9E3F1"
                                BorderThickness="1" Padding="7" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#182E50" BlurRadius="18" ShadowDepth="4" Opacity="0.17" />
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="9,7,9,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="批量规则操作" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#1C304C" />
                                        <TextBlock Text="选择操作范围与状态" FontSize="11"
                                                   Foreground="#7A8BA5" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#EAF2FF" CornerRadius="7"
                                            Padding="7,3" VerticalAlignment="Center">
                                        <TextBlock Text="4 项" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#3C6BC1" />
                                    </Border>
                                </Grid>
                                <Border Height="1" Background="#EDF1F7" Margin="6,3,6,5" />
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标由菜单项自己的 Icon 提供；保留 MenuItem 的原始 Click 事件和键盘导航。 -->
        <Style x:Key="BatchActionMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#24364F" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="BatchMenuItemSurface" Margin="2,1" Padding="9,7"
                                MinHeight="42" Background="Transparent" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="39" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                      TextElement.FontWeight="SemiBold" />
                                    <TextBlock Text="{TemplateBinding Tag}" FontSize="10.5"
                                               Foreground="#8390A5" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="BatchMenuItemSurface" Property="Background" Value="#EDF4FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="BatchMenuItemSurface" Property="Background" Value="#EDF4FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BatchMenuItemSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BatchActionMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="#EDF1F7" Height="1" Margin="10,6" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageCardStyle}" Padding="18,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="PLC 配置" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />

                <Border Grid.Column="1" Background="#EEF3FA" CornerRadius="14"
                        Padding="10,6" VerticalAlignment="Center" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PlcServerStatusEllipse" Width="7" Height="7"
                                 Fill="#64748B" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock x:Name="PlcServerStatusTextBlock" Text="服务未启动"
                                   FontSize="12" VerticalAlignment="Center" Foreground="#536580" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ToggleAllPlcsButton" Content="全部启用"
                            Style="{StaticResource NormalButtonStyle}"
                            ToolTip="操作全部 PLC，包含筛选隐藏的项。"
                            Click="ToggleAllPlcsButton_Click" />
                    <Button Content="点位变化记录" Style="{StaticResource NormalButtonStyle}"
                            Click="OpenPointChangeMonitorButton_Click" />
                    <Button Content="复位全部 PLC" Style="{StaticResource MaintenanceButtonStyle}"
                            Margin="0" Click="ResetAllDbBlockButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="490" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PageCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="AddPlcButton" Content="新增" Style="{StaticResource NormalButtonStyle}"
                                    Click="AddPlcButton_Click" />
                            <Button x:Name="BatchAddPlcsButton" Content="批量添加PLC" Style="{StaticResource AccentButtonStyle}"
                                    ToolTip="按IP范围批量生成，或粘贴自定义IP清单；支持自定义编号、名称、端口和默认DB块。"
                                    Click="BatchAddPlcsButton_Click" />
                            <Button x:Name="BatchAddNetworkIpButton" Content="批量添加IP"
                                    Style="{StaticResource NormalButtonStyle}"
                                    ToolTip="选择指定网卡，按连续范围或自定义IP清单批量添加辅助IPv4地址。"
                                    Click="BatchAddNetworkIpButton_Click" />
                            <Button x:Name="RemovePlcButton" Content="删除" Margin="0"
                                    Style="{StaticResource MaintenanceButtonStyle}"
                                    Click="RemovePlcButton_Click" />
                        </StackPanel>
                        <TextBlock Text="PLC 列表" Style="{StaticResource SectionTitleStyle}" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,8,0">
                            <TextBox x:Name="PlcSearchTextBox" Style="{StaticResource PlcTextInputStyle}"
                                     Text="{Binding PlcSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="搜索 PLC"
                                     ToolTip="支持 ID、名称、IP、端口和 IP:端口。" />
                            <TextBlock Text="搜索 ID、名称、IP 或端口" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#657690">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=PlcSearchTextBox}"
                                                         Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ComboBox Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource PlcComboStyle}"
                                  SelectedIndex="{Binding PlcModeFilterIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="筛选连接方式">
                            <ComboBoxItem Content="全部方式" />
                            <ComboBoxItem Content="端口代理" />
                            <ComboBoxItem Content="直连" />
                        </ComboBox>

                        <Button x:Name="ClearPlcFilterButton" Grid.Column="2" Content="清除" Height="38" Margin="0"
                                Style="{StaticResource NormalButtonStyle}" Click="ClearPlcFilterButton_Click"
                                ToolTip="清除搜索和方式筛选。" />
                    </Grid>

                    <TextBlock x:Name="PlcListSummaryTextBlock" Grid.Row="2"
                               Text="显示 0 / 0 台" Margin="0,12,0,8"
                               Foreground="{StaticResource MutedTextBrush}" />

                    <Border Grid.Row="3" Style="{StaticResource TableFrameStyle}">
                        <Grid>
                            <DataGrid x:Name="PlcListDataGrid"
                                      ItemsSource="{Binding PlcListView}"
                                      SelectedItem="{Binding SelectedPlc, Mode=TwoWay}"
                                      IsSynchronizedWithCurrentItem="False"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      ToolTip="按住 Ctrl 可逐个多选，按住 Shift 可连续多选 PLC。"
                                      SelectionChanged="PlcListDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="启用" Width="48" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          IsThreeState="False"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Click="PlcEnableCheckBox_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="ID" Width="46" Binding="{Binding PlcId}"
                                                        ElementStyle="{StaticResource PlcListTextStyle}" />
                                    <DataGridTextColumn Header="名称" Width="82" Binding="{Binding PlcName}"
                                                        ElementStyle="{StaticResource PlcListTextStyle}" />

                                    <DataGridTemplateColumn Header="方式" Width="54" SortMemberPath="ConnectionMode">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock"
                                                               BasedOn="{StaticResource PlcListTextStyle}">
                                                            <Setter Property="Text" Value="代理" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ConnectionMode}"
                                                                             Value="{x:Static plc:PlcConnectionMode.Direct}">
                                                                    <Setter Property="Text" Value="直连" />
                                                                    <Setter Property="Foreground" Value="#204FAE" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="连接端点" Width="*" MinWidth="142" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <TextBlock x:Name="ProxyEndpoint"
                                                               Style="{StaticResource PlcEndpointTextStyle}">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0}:{1}">
                                                                <Binding Path="IpAddress" />
                                                                <Binding Path="ProxyPort" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock x:Name="DirectEndpoint" Visibility="Collapsed"
                                                               Style="{StaticResource PlcEndpointTextStyle}">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0}:{1}">
                                                                <Binding Path="DirectListenAddress" />
                                                                <Binding Path="DirectListenPort" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding ConnectionMode}"
                                                                 Value="{x:Static plc:PlcConnectionMode.Direct}">
                                                        <Setter TargetName="ProxyEndpoint" Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Setter TargetName="DirectEndpoint" Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="连接数" Width="62" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           ToolTip="当前 TCP 连接数，包含握手中的客户端。">
                                                    <TextBlock.Text>
                                                        <MultiBinding Mode="OneWay"
                                                                      Converter="{StaticResource PlcConnectionCountConverter}">
                                                            <Binding Path="PlcId" />
                                                            <Binding Path="DataContext.PlcConnectionCounts"
                                                                     RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="PlcListEmptyTextBlock" Text="没有匹配的 PLC"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PageCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding SelectedPlc.PlcName, FallbackValue='请选择 PLC', TargetNullValue='请选择 PLC'}"
                               FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,14" />

                    <TabControl Grid.Row="1" Style="{StaticResource PlcTabsStyle}">
                        <TabItem Header="连接参数" Style="{StaticResource PlcTabStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PlcDetailEditPanel" Margin="0,0,8,0">
                                    <Border Style="{StaticResource FormSectionStyle}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="基本信息" Style="{StaticResource SectionTitleStyle}"
                                                       Margin="0,0,0,14" />
                                            <Grid Style="{StaticResource PlcEditableFieldsStyle}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="0.65*" />
                                                    <ColumnDefinition Width="1.35*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                    <TextBlock Text="PLC ID" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Style="{StaticResource PlcTextInputStyle}"
                                                             Text="{Binding PlcId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="PLC ID" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                    <TextBlock Text="名称" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Style="{StaticResource PlcTextInputStyle}"
                                                             Text="{Binding PlcName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="名称" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                                                    <TextBlock Text="PLC 类型" Style="{StaticResource FieldLabelStyle}" />
                                                    <ComboBox Style="{StaticResource PlcComboStyle}"
                                                              SelectedValuePath="Content"
                                                              AutomationProperties.Name="PLC 类型"
                                                              SelectedValue="{Binding PlcType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                        <ComboBoxItem Content="S1200" />
                                                        <ComboBoxItem Content="S1500" />
                                                        <ComboBoxItem Content="S300" />
                                                        <ComboBoxItem Content="S400" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="连接方式" Style="{StaticResource FieldLabelStyle}" />
                                                    <ComboBox Style="{StaticResource PlcComboStyle}"
                                                              SelectedValuePath="Tag"
                                                              AutomationProperties.Name="连接方式"
                                                              SelectedValue="{Binding ConnectionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                        <ComboBoxItem Content="端口代理"
                                                                      Tag="{x:Static plc:PlcConnectionMode.PortProxy}" />
                                                        <ComboBoxItem Content="直连"
                                                                      Tag="{x:Static plc:PlcConnectionMode.Direct}" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource FormSectionStyle}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button x:Name="UseProxyEndpointForDirectButton" Content="按原地址直连"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            Click="UseProxyEndpointForDirectButton_Click"
                                                            ToolTip="将这台 PLC 的代理 IP 和端口填入直连设置。" />
                                                    <Button x:Name="CopyPlcEndpointButton" Content="复制端点" Margin="0"
                                                            Style="{StaticResource NormalButtonStyle}"
                                                            Click="CopyPlcEndpointButton_Click" />
                                                </StackPanel>
                                                <TextBlock Text="连接端点" Style="{StaticResource SectionTitleStyle}" />
                                            </DockPanel>

                                            <Grid Style="{StaticResource PlcEditableFieldsStyle}">
                                                <Grid Style="{StaticResource PlcPortProxyFieldsStyle}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                        <TextBlock Text="代理 IP"
                                                                   Style="{StaticResource FieldLabelStyle}" />
                                                        <TextBox Style="{StaticResource PlcTextInputStyle}"
                                                                 Text="{Binding IpAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="代理 IP" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                        <TextBlock Text="代理端口" Style="{StaticResource FieldLabelStyle}" />
                                                        <TextBox Style="{StaticResource PlcTextInputStyle}"
                                                                 Text="{Binding ProxyPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="代理端口" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="0">
                                                        <TextBlock Text="内部端口" Style="{StaticResource FieldLabelStyle}" />
                                                        <TextBox Style="{StaticResource PlcTextInputStyle}"
                                                                 Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="内部端口" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Style="{StaticResource PlcDirectFieldsStyle}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                        <TextBlock Text="直连 IP"
                                                                   Style="{StaticResource FieldLabelStyle}" />
                                                        <TextBox Style="{StaticResource PlcTextInputStyle}"
                                                                 Text="{Binding DirectListenAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="直连 IP"
                                                                 ToolTip="仿真器监听的 Windows 本机 IPv4 地址。" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="0">
                                                        <TextBlock Text="直连端口" Style="{StaticResource FieldLabelStyle}" />
                                                        <TextBox Style="{StaticResource PlcTextInputStyle}"
                                                                 Text="{Binding DirectListenPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="直连端口" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource FormSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="运行参数" Style="{StaticResource SectionTitleStyle}"
                                                       Margin="0,0,0,10" />
                                            <UniformGrid Columns="3" Style="{StaticResource PlcEditableFieldsStyle}">
                                                <StackPanel Margin="0,0,14,12">
                                                    <TextBlock Text="Rack" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Style="{StaticResource PlcTextInputStyle}"
                                                             Text="{Binding Rack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Rack" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,14,12">
                                                    <TextBlock Text="Slot" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Style="{StaticResource PlcTextInputStyle}"
                                                             Text="{Binding Slot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Slot" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="轮询间隔 (ms)"
                                                               Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Style="{StaticResource PlcTextInputStyle}"
                                                             Text="{Binding PollIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="轮询间隔 (ms)" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="连接超时 (ms)"
                                                               Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Style="{StaticResource PlcTextInputStyle}"
                                                             Text="{Binding ConnectTimeOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="连接超时 (ms)"
                                                             ToolTip="从 TCP 接入到 S7 参数协商完成的等待时间。" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="接收超时 (ms)"
                                                               Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Style="{StaticResource PlcTextInputStyle}"
                                                             Text="{Binding ReceiveTimeOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="接收超时 (ms)"
                                                             ToolTip="会话建立后单次 S7 报文收发的等待时间。" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="自动写入" Style="{StaticResource FieldLabelStyle}" />
                                                    <CheckBox Content="启用" Height="38"
                                                              VerticalContentAlignment="Center"
                                                              ToolTip="PLC、DB 块、规则引用和全局规则都启用时，自动写入才会执行。"
                                                              IsChecked="{Binding AutoWriteEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Click="PlcAutoWriteEnabledCheckBox_Click" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>


                        <TabItem Header="DB 块" Style="{StaticResource PlcTabStyle}">
                            <Grid x:Name="DbBlockEditPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <WrapPanel Margin="0,0,0,12">
                                    <Button Content="新增 DB 块" Style="{StaticResource NormalButtonStyle}"
                                            Click="AddDbBlockButton_Click" />
                                    <Button Content="删除 DB 块" Style="{StaticResource MaintenanceButtonStyle}"
                                            Click="RemoveDbBlockButton_Click" />
                                    <Button Content="添加默认 DB" Style="{StaticResource NormalButtonStyle}"
                                            Click="AddDefaultDbBlocksButton_Click" />
                                    <Button Content="复位当前 DB" Style="{StaticResource NormalButtonStyle}"
                                            Click="ResetDbBlockButton_Click" />
                                    <Button Content="全局复位配置" Style="{StaticResource NormalButtonStyle}"
                                            Click="OpenDbBlockResetConfigButton_Click" />
                                    <!-- 批量导入：作用于左侧PLC列表中多选的PLC，统一导入到各自DB1500 -->
                                    <Button Content="批量导入基础协议" Style="{StaticResource NormalButtonStyle}"
                                            ToolTip="在左侧PLC列表按 Ctrl/Shift 多选。向选中PLC的DB1500导入基础协议，已有项不覆盖；导入后点击保存配置。"
                                            Click="ImportBasicProtocolToSelectedPlcsButton_Click" />
                                </WrapPanel>

                                <Border Grid.Row="1" Style="{StaticResource TableFrameStyle}">
                                    <DataGrid ItemsSource="{Binding SelectedPlc.DbBlocks}"
                                              SelectedItem="{Binding SelectedDbBlock, Mode=TwoWay}"
                                              IsSynchronizedWithCurrentItem="False"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              HeadersVisibility="Column"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="启用" Width="48">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Click="DbBlockEnabledCheckBox_Click" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="自动写入" Width="72">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding AutoWriteEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Click="DbBlockAutoWriteEnabledCheckBox_Click" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Header="DB 块"
                                                                Width="64"
                                                                Binding="{Binding DbNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                ElementStyle="{StaticResource PlcListTextStyle}" />

                                            <DataGridTextColumn Header="长度"
                                                                Width="66"
                                                                Binding="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                ElementStyle="{StaticResource PlcListTextStyle}" />

                                            <DataGridTextColumn Header="名称"
                                                                Width="*" MinWidth="92"
                                                                Binding="{Binding BlockName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                ElementStyle="{StaticResource PlcListTextStyle}" />

                                            <DataGridTextColumn Header="备注"
                                                                Width="1.3*" MinWidth="110"
                                                                Binding="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                ElementStyle="{StaticResource PlcListTextStyle}" />

                                            <DataGridTemplateColumn Header="点位操作" Width="208" CanUserSort="False" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center">
                                                            <Button Content="查看位值" Style="{StaticResource TableActionStyle}"
                                                                    IsEnabled="{Binding DataContext.CanViewDbBlockBits, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Click="ViewDbBlockBitsButton_Click" />
                                                            <Button Content="配置协议" Style="{StaticResource TableActionStyle}"
                                                                    Margin="4,0" Click="OpenProtocolBoardConfigButton_Click" />
                                                            <Button Content="操作面板" Style="{StaticResource TableActionStyle}"
                                                                    Foreground="#204FAE" Background="#EAF2FF" BorderBrush="#C5D8FA"
                                                                    FontWeight="SemiBold" ToolTip="打开本行 DB 块的点位操作面板"
                                                                    Click="OpenOperationPanelButton_Click" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="自动写入规则" Style="{StaticResource PlcTabStyle}">
                            <Grid x:Name="AutoWriteRuleEditPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="0,0,0,14">
                                    <TextBlock DockPanel.Dock="Left" Text="当前 DB 块"
                                               Style="{StaticResource SectionTitleStyle}" Margin="0,0,14,0" />
                                    <Grid Width="168" HorizontalAlignment="Left">
                                        <ComboBox Style="{StaticResource PlcComboStyle}"
                                                  ItemsSource="{Binding SelectedPlc.DbBlocks}"
                                                  SelectedItem="{Binding SelectedDbBlock, Mode=TwoWay}"
                                                  IsSynchronizedWithCurrentItem="False"
                                                  DisplayMemberPath="DbNumber"
                                                  AutomationProperties.Name="当前 DB 块" />
                                        <TextBlock Margin="12,0,0,0"
                                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Foreground="{StaticResource MutedTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedDbBlock}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>

                                <Border Grid.Row="1" Style="{StaticResource FormSectionStyle}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <DockPanel Margin="0,0,0,10">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="全选" Style="{StaticResource NormalButtonStyle}"
                                                        Command="{x:Static ApplicationCommands.SelectAll}"
                                                        CommandTarget="{Binding ElementName=GlobalAutoWriteRulesDataGrid}" />
                                                <!-- 全局规则库：批量切换全局启用状态（不修改未保存的规则正文）。 -->
                                                <!-- 四种启停操作整合到一个下拉菜单；旧按钮原代码保留并折叠。 -->
                                                <Button Content="批量启停" Style="{StaticResource BatchActionButtonStyle}"
                                                        ToolTip="批量修改全局规则启用状态；禁用时同步停用PLC/DB块绑定"
                                                        Click="OpenAutoWriteRuleBatchMenu_Click">
                                                    <Button.ContextMenu>
                                                        <ContextMenu Style="{StaticResource BatchActionContextMenuStyle}">
    <MenuItem Header="全部启用" Tag="启用当前列表中的全部规则" Style="{StaticResource BatchActionMenuItemStyle}"
              Click="EnableAllGlobalRulesButton_Click">
        <MenuItem.Icon>
            <Border Width="32" Height="32" CornerRadius="8" Background="#E6F7EE">
                <Path Data="M 3,9 L 7,13 L 15,5" Width="16" Height="16" Stretch="Uniform"
                      Stroke="#18875A" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="全部禁用" Tag="停用当前列表中的全部规则" Style="{StaticResource BatchActionMenuItemStyle}"
              Click="DisableAllGlobalRulesButton_Click">
        <MenuItem.Icon>
            <Border Width="32" Height="32" CornerRadius="8" Background="#FFF0EF">
                <Path Data="M 4,4 L 14,14 M 14,4 L 4,14" Width="16" Height="16" Stretch="Uniform"
                      Stroke="#CC565A" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </MenuItem.Icon>
    </MenuItem>
    <Separator Style="{StaticResource BatchActionMenuSeparatorStyle}" />
    <MenuItem Header="选中启用" Tag="只启用当前选中的规则" Style="{StaticResource BatchActionMenuItemStyle}"
              Click="EnableSelectedGlobalRulesButton_Click">
        <MenuItem.Icon>
            <Border Width="32" Height="32" CornerRadius="8" Background="#E9F1FF">
                <Path Data="M 3,9 L 7,13 L 15,5" Width="16" Height="16" Stretch="Uniform"
                      Stroke="#3268CB" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="选中禁用" Tag="只停用当前选中的规则" Style="{StaticResource BatchActionMenuItemStyle}"
              Click="DisableSelectedGlobalRulesButton_Click">
        <MenuItem.Icon>
            <Border Width="32" Height="32" CornerRadius="8" Background="#FFF4E7">
                <Path Data="M 4,4 L 14,14 M 14,4 L 4,14" Width="16" Height="16" Stretch="Uniform"
                      Stroke="#B47B2E" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </MenuItem.Icon>
    </MenuItem>
</ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                                <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                                                <Button Content="全部启用" Style="{StaticResource NormalButtonStyle}"
                                                        ToolTip="启用规则库中全部规则，立即持久化开关状态"
                                                        Click="EnableAllGlobalRulesButton_Click" />
                                                <Button Content="全部禁用" Style="{StaticResource NormalButtonStyle}"
                                                        ToolTip="禁用规则库中全部规则，同时停用对应PLC绑定"
                                                        Click="DisableAllGlobalRulesButton_Click" />
                                                <Button Content="选中启用" Style="{StaticResource AccentButtonStyle}"
                                                        ToolTip="启用当前多选的全局规则"
                                                        Click="EnableSelectedGlobalRulesButton_Click" />
                                                <Button Content="选中禁用" Style="{StaticResource NormalButtonStyle}"
                                                        ToolTip="禁用当前多选的全局规则"
                                                        Click="DisableSelectedGlobalRulesButton_Click" />
                                                </StackPanel>
                                                <Button Content="刷新" Style="{StaticResource NormalButtonStyle}"
                                                        ToolTip="刷新全局规则库"
                                                        Click="RefreshGlobalRulesButton_Click" />
                                                <Button Content="管理规则" Style="{StaticResource NormalButtonStyle}"
                                                        Click="ManageGlobalAutoWriteRulesButton_Click" />
                                                <Button Content="绑定选中" Style="{StaticResource AccentButtonStyle}"
                                                        ToolTip="把选中的已启用规则绑定到当前 DB 块。"
                                                        Margin="0" Click="BindSelectedGlobalRuleButton_Click" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        ToolTip="Ctrl 点选多条，Shift 连选，Ctrl+A 全选。">
                                                <TextBlock Text="全局规则库" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Text="{Binding SelectedItems.Count, ElementName=GlobalAutoWriteRulesDataGrid, StringFormat='已选 {0} 条'}" />
                                            </StackPanel>
                                        </DockPanel>

                                        <Border Grid.Row="1" Style="{StaticResource TableFrameStyle}">
                                            <DataGrid x:Name="GlobalAutoWriteRulesDataGrid"
                                                      ItemsSource="{Binding GlobalAutoWriteRules}"
                                                      SelectedItem="{Binding SelectedGlobalRule, Mode=TwoWay}"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      HeadersVisibility="Column"
                                                      SelectionMode="Extended"
                                                      SelectionUnit="FullRow">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="启用" Width="64" IsReadOnly="True">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Style="{StaticResource RuleEnabledSwitchStyle}"
                                                                          AutomationProperties.Name="全局规则启用"
                                                                          ToolTip="点击启用或停用这条全局规则。"
                                                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                                          Click="GlobalRuleEnabledCheckBox_Click" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTextColumn Header="ID" IsReadOnly="True"
                                                                        Width="48"
                                                                        Binding="{Binding RuleId}"
                                                                        ElementStyle="{StaticResource PlcListTextStyle}" />

                                                    <DataGridTextColumn Header="规则名称" IsReadOnly="True"
                                                                        Width="1.1*" MinWidth="108"
                                                                        Binding="{Binding RuleName}"
                                                                        ElementStyle="{StaticResource PlcListTextStyle}" />

                                                    <DataGridTextColumn Header="延时" IsReadOnly="True"
                                                                        Width="76"
                                                                        Binding="{Binding DelayTriggerSummary}"
                                                                        ElementStyle="{StaticResource PlcListTextStyle}" />

                                                    <DataGridTextColumn Header="写入" IsReadOnly="True"
                                                                        Width="52"
                                                                        Binding="{Binding WriteItems.Count}"
                                                                        ElementStyle="{StaticResource PlcListTextStyle}" />

                                                    <DataGridTextColumn Header="备注" IsReadOnly="True"
                                                                        Width="*" MinWidth="90"
                                                                        Binding="{Binding Remark}"
                                                                        ElementStyle="{StaticResource PlcListTextStyle}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="3" Style="{StaticResource FormSectionStyle}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <DockPanel Margin="0,0,0,10">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="全选" Style="{StaticResource NormalButtonStyle}"
                                                        Command="{x:Static ApplicationCommands.SelectAll}"
                                                        CommandTarget="{Binding ElementName=DbBlockRuleRefsDataGrid}" />
                                                <!-- DB块引用的批量启停仅影响当前PLC当前DB块，不修改全局规则库。 -->
                                                <!-- 四种启停操作整合到一个下拉菜单；旧按钮原代码保留并折叠。 -->
                                                <Button Content="批量启停" Style="{StaticResource BatchActionButtonStyle}"
                                                        ToolTip="批量修改当前PLC当前DB块的规则绑定状态"
                                                        Click="OpenAutoWriteRuleBatchMenu_Click">
                                                    <Button.ContextMenu>
                                                        <ContextMenu Style="{StaticResource BatchActionContextMenuStyle}">
    <MenuItem Header="全部启用" Tag="启用当前列表中的全部规则" Style="{StaticResource BatchActionMenuItemStyle}"
              Click="EnableAllDbBlockRuleRefsButton_Click">
        <MenuItem.Icon>
            <Border Width="32" Height="32" CornerRadius="8" Background="#E6F7EE">
                <Path Data="M 3,9 L 7,13 L 15,5" Width="16" Height="16" Stretch="Uniform"
                      Stroke="#18875A" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="全部禁用" Tag="停用当前列表中的全部规则" Style="{StaticResource BatchActionMenuItemStyle}"
              Click="DisableAllDbBlockRuleRefsButton_Click">
        <MenuItem.Icon>
            <Border Width="32" Height="32" CornerRadius="8" Background="#FFF0EF">
                <Path Data="M 4,4 L 14,14 M 14,4 L 4,14" Width="16" Height="16" Stretch="Uniform"
                      Stroke="#CC565A" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </MenuItem.Icon>
    </MenuItem>
    <Separator Style="{StaticResource BatchActionMenuSeparatorStyle}" />
    <MenuItem Header="选中启用" Tag="只启用当前选中的规则" Style="{StaticResource BatchActionMenuItemStyle}"
              Click="EnableSelectedDbBlockRuleRefsButton_Click">
        <MenuItem.Icon>
            <Border Width="32" Height="32" CornerRadius="8" Background="#E9F1FF">
                <Path Data="M 3,9 L 7,13 L 15,5" Width="16" Height="16" Stretch="Uniform"
                      Stroke="#3268CB" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="选中禁用" Tag="只停用当前选中的规则" Style="{StaticResource BatchActionMenuItemStyle}"
              Click="DisableSelectedDbBlockRuleRefsButton_Click">
        <MenuItem.Icon>
            <Border Width="32" Height="32" CornerRadius="8" Background="#FFF4E7">
                <Path Data="M 4,4 L 14,14 M 14,4 L 4,14" Width="16" Height="16" Stretch="Uniform"
                      Stroke="#B47B2E" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </MenuItem.Icon>
    </MenuItem>
</ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                                <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                                                <Button Content="全部启用" Style="{StaticResource NormalButtonStyle}"
                                                        ToolTip="启用当前DB块全部绑定规则（全局未启用的规则会跳过）"
                                                        Click="EnableAllDbBlockRuleRefsButton_Click" />
                                                <Button Content="全部禁用" Style="{StaticResource NormalButtonStyle}"
                                                        ToolTip="禁用当前DB块全部绑定规则"
                                                        Click="DisableAllDbBlockRuleRefsButton_Click" />
                                                <Button Content="选中启用" Style="{StaticResource AccentButtonStyle}"
                                                        ToolTip="启用当前DB块中多选的规则绑定"
                                                        Click="EnableSelectedDbBlockRuleRefsButton_Click" />
                                                <Button Content="选中禁用" Style="{StaticResource NormalButtonStyle}"
                                                        ToolTip="禁用当前DB块中多选的规则绑定"
                                                        Click="DisableSelectedDbBlockRuleRefsButton_Click" />
                                                </StackPanel>
                                                <Button Content="规则点位监视"
                                                        Style="{StaticResource NormalButtonStyle}"
                                                        IsEnabled="{Binding CanViewDbBlockBits}"
                                                        Click="ViewRulePointsButton_Click" />
                                                <Button Content="解绑选中" Style="{StaticResource MaintenanceButtonStyle}"
                                                        Margin="0" Click="RemoveSelectedRuleRefButton_Click" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="已绑定规则" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Text="{Binding SelectedItems.Count, ElementName=DbBlockRuleRefsDataGrid, StringFormat='已选 {0} 条'}" />
                                            </StackPanel>
                                        </DockPanel>

                                        <Border Grid.Row="1" Style="{StaticResource TableFrameStyle}">
                                            <DataGrid x:Name="DbBlockRuleRefsDataGrid"
                                                      ItemsSource="{Binding SelectedDbBlock.AutoWriteRuleList}"
                                                      SelectedItem="{Binding SelectedDbBlockRuleRef, Mode=TwoWay}"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      HeadersVisibility="Column"
                                                      SelectionMode="Extended"
                                                      SelectionUnit="FullRow">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="启用" Width="64">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          Style="{StaticResource GloballyGatedRuleCheckBoxStyle}"
                                                                          ToolTip="只有全局规则库已启用的规则才能在PLC中启用；全局停用时会自动取消已绑定规则的启用状态。"
                                                                          Click="DbBlockRuleRefEnabledCheckBox_Click" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- 显示全局规则的真实启用状态，防止误以为绑定即有效。 -->
                                                    <DataGridTemplateColumn Header="全局状态" Width="108">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="{StaticResource MutedTextBrush}">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding Converter="{StaticResource PlcGlobalRuleEnabledConverter}"
                                                                                      ConverterParameter="status">
                                                                            <Binding Path="RuleId" />
                                                                            <Binding Path="DataContext.GlobalRuleEnabledStates"
                                                                                     RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTextColumn Header="规则 ID"
                                                                        Width="70"
                                                                        IsReadOnly="True"
                                                                        Binding="{Binding RuleId}"
                                                                        ElementStyle="{StaticResource PlcListTextStyle}" />

                                                    <DataGridTextColumn Header="规则名称"
                                                                        Width="1.1*" MinWidth="118"
                                                                        IsReadOnly="True"
                                                                        Binding="{Binding RuleName}"
                                                                        ElementStyle="{StaticResource PlcListTextStyle}" />

                                                    <DataGridTextColumn Header="顺序"
                                                                        Width="60"
                                                                        Binding="{Binding SortIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        ElementStyle="{StaticResource PlcListTextStyle}" />

                                                    <DataGridTextColumn Header="备注"
                                                                        Width="*" MinWidth="112"
                                                                        Binding="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        ElementStyle="{StaticResource PlcListTextStyle}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PageCardStyle}" Padding="18,10" Margin="0,16,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="关闭" Style="{StaticResource NormalButtonStyle}" Click="CancelButton_Click" />
                    <Button Content="保存配置" MinWidth="82" Margin="0"
                            Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" />
                </StackPanel>

                <TextBlock x:Name="PlcServerStatusHintTextBlock" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>