<views:PlcToolPage x:Class="Vda5050AgvSimulator.Views.PlcDbBlockProtocolPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Vda5050AgvSimulator.Views"
        Title="PLC 点位操作面板"
        Background="{StaticResource WorkspaceCanvasBrush}"
        Foreground="{StaticResource WorkspaceInkBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <views:PlcToolPage.Resources>
        <!-- 动态计算卡片宽度：按窗口宽度自动决定每行个数，保证绝不超出容器 -->
        <views:AdaptivePointCardWidthConverter x:Key="AdaptivePointCardWidthConverter" />

        <!-- 全局配色：清爽的工业监控面板风格 -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PageBrush" Color="{StaticResource WorkspaceCanvasColor}" />
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource WorkspaceLineColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource WorkspaceAccentColor}" />
        <SolidColorBrush x:Key="AccentFillBrush" Color="{StaticResource WorkspaceAccentTintColor}" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#415E65" />

        <!-- 工具按钮 -->
        <ControlTemplate x:Key="ButtonChromeTemplate" TargetType="Button">
            <Border x:Name="ButtonChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter ContentSource="Content"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                  RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#AAD5D1" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.76" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PanelButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource ButtonChromeTemplate}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#415E65" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- 两种尺寸的数值按钮共用同一套双击及鼠标捕获事件。 -->
        <Style x:Key="PointValueButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PointValueButton_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="PointValueButton_PreviewMouseLeftButtonUp" />
            <EventSetter Event="LostMouseCapture" Handler="PointValueButton_LostMouseCapture" HandledEventsToo="True" />
            <Setter Property="AutomationProperties.HelpText" Value="双击修改数值" />
            <Setter Property="Content" Value="{Binding Point.CurrentValue}" />
            <Setter Property="ToolTip" Value="{Binding Point.CurrentValue}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="29" />
            <Setter Property="Width" Value="72" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource WorkspaceAccentTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WorkspaceAccentTintBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Point.CurrentValue}" Value="">
                    <Setter Property="Content" Value="（空）" />
                    <Setter Property="ToolTip" Value="双击修改" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Point.IsBoolean}" Value="True">
                    <Setter Property="ToolTip" Value="双击取反" />
                    <Setter Property="AutomationProperties.HelpText" Value="双击切换 0 / 1" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Point.IsBoolean}" Value="True" />
                        <Condition Binding="{Binding Point.CurrentValue}" Value="True" />
                        <Condition Binding="{Binding Point.HasCurrentValue}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Content" Value="1" />
                    <Setter Property="Background" Value="#E5F7ED" />
                    <Setter Property="BorderBrush" Value="#BDEACF" />
                    <Setter Property="Foreground" Value="#14804E" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Point.IsBoolean}" Value="True" />
                        <Condition Binding="{Binding Point.CurrentValue}" Value="False" />
                        <Condition Binding="{Binding Point.HasCurrentValue}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Content" Value="0" />
                    <Setter Property="Background" Value="{StaticResource WorkspaceCanvasBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource WorkspaceLineBrush}" />
                    <Setter Property="Foreground" Value="#415E65" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Point.HasCurrentValue}" Value="False">
                    <Setter Property="Content" Value="—" />
                    <Setter Property="ToolTip" Value="{Binding Point.LastMessage}" />
                    <Setter Property="Background" Value="{StaticResource WorkspaceCanvasBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource WorkspaceLineBrush}" />
                    <Setter Property="Foreground" Value="#64828A" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Point.IsBoolean}" Value="True" />
                        <Condition Binding="{Binding Point.HasCurrentValue}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsEnabled" Value="False" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Point.IsEnabled}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Target.IsPlcRunning}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 点位卡片：目标宽度最小100，窄卡片自动切换紧凑布局 -->
        <Style x:Key="PointCardStyle" TargetType="Border">
            <Setter Property="Height" Value="59" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="{StaticResource WorkspaceAccentTintBrush}" />
            <Setter Property="BorderBrush" Value="#E8F0F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource WorkspaceAccentTintBrush}" />
                    <Setter Property="BorderBrush" Value="#AAD5D1" />
                </Trigger>
                <DataTrigger
                    Binding="{Binding DataContext.IsCompactCard, RelativeSource={RelativeSource AncestorType={x:Type views:PlcToolPage}}}"
                    Value="True">
                    <Setter Property="Height" Value="74" />
                    <Setter Property="Padding" Value="6,5" />
                    <Setter Property="CornerRadius" Value="6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 目标下拉框：代替默认系统下拉框，统一圆角和内部间距 -->
        <Style x:Key="TargetPickerStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="135" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
            <Setter Property="Foreground" Value="#193E4A" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource WorkspaceLineBrush}" />
            <Setter Property="ToolTip" Value="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"
                                   ToolTip="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="9,7" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemChrome"
                                            Padding="{TemplateBinding Padding}"
                                            Background="Transparent"
                                            CornerRadius="5">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource WorkspaceAccentTintBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource WorkspaceAccentTintBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsTabStop="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboChrome"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Grid Margin="10,0,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="18" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Stroke="#516D73"
                                                      StrokeThickness="1.6"
                                                      Data="M 2,5 L 6,9 L 10,5" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#AAD5D1" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboChrome" Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Margin="0,3,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="320"
                                        Padding="5"
                                        Background="White"
                                        BorderBrush="{StaticResource WorkspaceLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{StaticResource WorkspaceInkColor}" BlurRadius="12" ShadowDepth="3"
                                                          Opacity="0.12" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DropDownToggle" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PLC 在线状态 -->
        <ControlTemplate x:Key="PlcStateTemplate" TargetType="ContentControl">
            <Border x:Name="StateBadge"
                    Height="28"
                    Padding="9,0"
                    Background="#FFF6E9"
                    CornerRadius="7">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StateDot" Width="7" Height="7" Margin="0,0,6,0" Fill="#D09240" />
                    <TextBlock x:Name="StateLabel" Text="未运行" Foreground="#A56D27" />
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPlcRunning}" Value="True">
                    <Setter TargetName="StateBadge" Property="Background" Value="#E7F7EE" />
                    <Setter TargetName="StateDot" Property="Fill" Value="#16A368" />
                    <Setter TargetName="StateLabel" Property="Text" Value="运行中" />
                    <Setter TargetName="StateLabel" Property="Foreground" Value="#188255" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PaneStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="10,0,2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="#D09240" />
            <Setter Property="ToolTip" Value="PLC未运行" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlcRunning}" Value="True">
                    <Setter Property="Fill" Value="#16A368" />
                    <Setter Property="ToolTip" Value="PLC运行中" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 统一的流式面板：ItemWidth 是按当前可用宽度计算的安全宽度 -->
        <ItemsPanelTemplate x:Key="AdaptivePointCardsPanel">
            <WrapPanel Orientation="Horizontal"
                       ItemWidth="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        </ItemsPanelTemplate>

        <!-- 不嵌套 ScrollViewer，点位自动换行并撑高页面 -->
        <DataTemplate x:Key="PointListTemplate">
            <Grid Margin="0,5,0,3">
                <ItemsControl x:Name="PointCards"
                              ItemsSource="{Binding}"
                              HorizontalAlignment="Stretch"
                              ItemsPanel="{StaticResource AdaptivePointCardsPanel}">
                    <ItemsControl.Tag>
                        <MultiBinding Converter="{StaticResource AdaptivePointCardWidthConverter}" Mode="OneWay">
                            <Binding Path="DataContext.CardSize" RelativeSource="{RelativeSource AncestorType={x:Type views:PlcToolPage}}" />
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </ItemsControl.Tag>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PointCardStyle}">
                                <Grid>
                                    <!-- 180及以上：双列布局 -->
                                    <Grid x:Name="NormalCardLayout">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       ToolTip="{Binding DisplayName}"
                                                       Foreground="{StaticResource WorkspaceInkBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Point.OffsetAddress}"
                                                       ToolTip="{Binding Point.OffsetAddress}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontFamily="Consolas, Microsoft YaHei UI"
                                                       FontSize="11"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding DisplayName}"
                                                Style="{StaticResource PointValueButtonStyle}" />
                                    </Grid>
                                    <!-- 100~160：上下布局，数值按钮随卡片宽度缩窄 -->
                                    <Grid x:Name="CompactCardLayout" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding DisplayName}"
                                                   ToolTip="{Binding DisplayName}"
                                                   Foreground="#193E4A"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,1,0,0"
                                                   Text="{Binding Point.OffsetAddress}"
                                                   ToolTip="{Binding Point.OffsetAddress}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Row="2"
                                                Width="Auto"
                                                Height="23"
                                                Margin="0,3,0,0"
                                                Padding="3,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Bottom"
                                                FontSize="10.5"
                                                AutomationProperties.Name="{Binding DisplayName}"
                                                Style="{StaticResource PointValueButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger
                                    Binding="{Binding DataContext.IsCompactCard, RelativeSource={RelativeSource AncestorType={x:Type views:PlcToolPage}}}"
                                    Value="True">
                                    <Setter TargetName="NormalCardLayout" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="CompactCardLayout" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,26">
                    <TextBlock Text="暂无点位数据"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Foreground="#64828A" />
                    <TextBlock Text="可在 PLC 协议配置中添加点位"
                               Margin="0,7,0,0"
                               Foreground="#9DB6B8"
                               HorizontalAlignment="Center" />
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=PointCards}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- TabControl 顶部独立为一行：左侧模式切换、右侧常用操作 -->
        <ControlTemplate x:Key="RangeTabsTemplate" TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="7" Background="{StaticResource TabRailBrush}" Padding="4">
                        <TabPanel IsItemsHost="True" VerticalAlignment="Center"
                                  KeyboardNavigation.TabIndex="0" KeyboardNavigation.TabNavigation="Once" />
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="卡片宽度" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="#516D73" />
                        <ComboBox x:Name="CardSizePicker" Width="76" MinWidth="76" Margin="0,0,12,0"
                                  Style="{StaticResource TargetPickerStyle}" ItemTemplate="{x:Null}"
                                  ItemsSource="{Binding CardSizeOptions}"
                                  SelectedItem="{Binding CardSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="卡片宽度为 100 至 360，修改框随卡片缩放。"
                                  AutomationProperties.Name="选择卡片宽度" />
                        <Button Content="立即刷新"
                                MinWidth="74"
                                Style="{StaticResource ToolButtonStyle}"
                                Click="RefreshButton_Click" />
                    </StackPanel>
                </Grid>
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  Grid.Row="1"
                                  ContentSource="SelectedContent"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" />
            </Grid>
        </ControlTemplate>
    </views:PlcToolPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="PageScrollViewer" Padding="16,14,16,10"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" PanningMode="VerticalOnly" Focusable="False">
            <Grid Background="Transparent" PreviewMouseLeftButtonDown="PageContent_PreviewMouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Margin="0,0,0,12" Background="White" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="刷新周期  800 ms" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <StackPanel>
                            <TextBlock Text="PLC 点位操作面板" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="双击数值可修改，双击布尔值可切换 0 / 1。" Margin="0,4,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TabControl x:Name="RangeTabs"
                            Grid.Row="1"
                            SelectedIndex="0"
                            Template="{StaticResource RangeTabsTemplate}"
                            SelectionChanged="RangeTabs_SelectionChanged">
                    <!-- AGV → PLC -->
                    <TabItem Header="AGV → PLC" ToolTip="字节偏移 0–199" Style="{StaticResource SectionTabItemStyle}">
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="13,12,13,9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,2,4,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="AGV → PLC" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource WorkspaceInkBrush}" />
                                            <Border Margin="9,0,0,0" Padding="6,2"
                                                    Background="{StaticResource WorkspaceCanvasBrush}" CornerRadius="4">
                                                <TextBlock Text="0–199" Foreground="#516D73" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="小车发送至 PLC 的点位"
                                                   Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="选择设备" VerticalAlignment="Center"
                                                   Margin="0,0,9,0" Foreground="#516D73" />
                                        <ComboBox Width="178" Margin="0,0,9,0"
                                                  ItemsSource="{Binding Targets}"
                                                  SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                                  AutomationProperties.Name="切换 PLC 和 DB"
                                                  Style="{StaticResource TargetPickerStyle}" />
                                        <ContentControl DataContext="{Binding SelectedTarget}"
                                                        Template="{StaticResource PlcStateTemplate}" />
                                        <TextBlock
                                            Text="{Binding SelectedTarget.AgvToPlc.Cards.Count, StringFormat={}{0} 个点位}"
                                            VerticalAlignment="Center" Margin="12,0,0,0"
                                            Foreground="#516D73" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" BorderBrush="{StaticResource WorkspaceCanvasBrush}" BorderThickness="0,1,0,0">
                                    <ContentControl Content="{Binding SelectedTarget.AgvToPlc.Cards}"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    ContentTemplate="{StaticResource PointListTemplate}" />
                                </Border>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- PLC → AGV -->
                    <TabItem Header="PLC → AGV" ToolTip="字节偏移 200–400" Style="{StaticResource SectionTabItemStyle}">
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="13,12,13,9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,2,4,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="PLC → AGV" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource WorkspaceInkBrush}" />
                                            <Border Margin="9,0,0,0" Padding="6,2"
                                                    Background="{StaticResource WorkspaceCanvasBrush}" CornerRadius="4">
                                                <TextBlock Text="200–400" Foreground="#516D73" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="PLC 发送至小车的点位"
                                                   Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="选择设备" VerticalAlignment="Center"
                                                   Margin="0,0,9,0" Foreground="#516D73" />
                                        <ComboBox Width="178" Margin="0,0,9,0"
                                                  ItemsSource="{Binding Targets}"
                                                  SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                                  AutomationProperties.Name="切换 PLC 和 DB"
                                                  Style="{StaticResource TargetPickerStyle}" />
                                        <ContentControl DataContext="{Binding SelectedTarget}"
                                                        Template="{StaticResource PlcStateTemplate}" />
                                        <TextBlock
                                            Text="{Binding SelectedTarget.PlcToAgv.Cards.Count, StringFormat={}{0} 个点位}"
                                            VerticalAlignment="Center" Margin="12,0,0,0"
                                            Foreground="#516D73" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" BorderBrush="{StaticResource WorkspaceCanvasBrush}" BorderThickness="0,1,0,0">
                                    <ContentControl Content="{Binding SelectedTarget.PlcToAgv.Cards}"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    ContentTemplate="{StaticResource PointListTemplate}" />
                                </Border>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- 左右对比：每侧独立 PLC/DB/方向，内容为严格等宽两列 -->
                    <TabItem Header="左右对比" Tag="Compare" Style="{StaticResource SectionTabItemStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="White" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="11,11,11,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="4,2,4,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Text="左侧点位" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="{StaticResource WorkspaceInkBrush}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding LeftRange.Cards.Count, StringFormat={}{0} 个点位}"
                                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                                                   VerticalAlignment="Center" />
                                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding RangeOptions}"
                                                      SelectedItem="{Binding LeftRange, Mode=TwoWay}"
                                                      AutomationProperties.Name="选择左栏 PLC、DB 和方向"
                                                      Style="{StaticResource TargetPickerStyle}" />
                                            <Ellipse Grid.Column="1" DataContext="{Binding LeftRange.Target}"
                                                     Style="{StaticResource PaneStatusDotStyle}" />
                                        </Grid>
                                    </Grid>
                                    <Border Grid.Row="1" BorderBrush="{StaticResource WorkspaceCanvasBrush}" BorderThickness="0,1,0,0">
                                        <ContentControl Content="{Binding LeftRange.Cards}"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"
                                                        ContentTemplate="{StaticResource PointListTemplate}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2"
                                    Background="White" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="11,11,11,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="4,2,4,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Text="右侧点位" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="{StaticResource WorkspaceInkBrush}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding RightRange.Cards.Count, StringFormat={}{0} 个点位}"
                                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                                                   VerticalAlignment="Center" />
                                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding RangeOptions}"
                                                      SelectedItem="{Binding RightRange, Mode=TwoWay}"
                                                      AutomationProperties.Name="选择右栏 PLC、DB 和方向"
                                                      Style="{StaticResource TargetPickerStyle}" />
                                            <Ellipse Grid.Column="1" DataContext="{Binding RightRange.Target}"
                                                     Style="{StaticResource PaneStatusDotStyle}" />
                                        </Grid>
                                    </Grid>
                                    <Border Grid.Row="1" BorderBrush="{StaticResource WorkspaceCanvasBrush}" BorderThickness="0,1,0,0">
                                        <ContentControl Content="{Binding RightRange.Cards}"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"
                                                        ContentTemplate="{StaticResource PointListTemplate}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </ScrollViewer>

        <!-- 写入反馈 -->
        <Border Grid.Row="1"
                Background="{StaticResource WorkspaceAccentTintBrush}"
                BorderBrush="{StaticResource WorkspaceAccentTintBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="10,7"
                Margin="16,0,16,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=OperationFeedbackText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="OperationFeedbackText"
                       TextTrimming="CharacterEllipsis"
                       Foreground="#415E65"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Border>

        <!-- 画布只在编辑条本身接收输入，其余区域可继续查看和滚动点位。 -->
        <Canvas x:Name="ValueEditorLayer" ClipToBounds="True">
            <Border x:Name="ValueEditorFlyout" Visibility="Collapsed" DataContext="{x:Null}"
                    Width="{Binding DataContext.EditorPopupWidth, RelativeSource={RelativeSource AncestorType={x:Type views:PlcToolPage}}}"
                    Padding="3" CornerRadius="6" Background="White" BorderBrush="#88BDBA" BorderThickness="1"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="ValueEditor_PreviewKeyDown" AutomationProperties.Name="修改点位值">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource WorkspaceInkColor}" BlurRadius="6" ShadowDepth="1" Opacity="0.18" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="21" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ValueEditorText" Style="{x:Null}" MinWidth="0" MinHeight="0"
                             Margin="0,0,3,0" Padding="3,0" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource WorkspaceInkBrush}" CaretBrush="{StaticResource WorkspaceAccentBrush}" FontFamily="Consolas, Microsoft YaHei UI"
                             FontSize="13" VerticalContentAlignment="Center" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                             AutomationProperties.Name="写入值" AutomationProperties.HelpText="{Binding DisplayName}">
                        <TextBox.ToolTip>
                            <ToolTip
                                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                            <Binding Path="Target.DisplayName" />
                                            <Binding Path="DisplayName" />
                                            <Binding Path="Point.DisplayAddress" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                    <Button Grid.Column="1" Style="{StaticResource PanelButtonStyle}" MinWidth="0" MinHeight="0"
                            Padding="0" Background="{StaticResource AccentBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            Foreground="White" ToolTip="写入（Enter）" AutomationProperties.Name="写入"
                            Click="SaveValueButton_Click">
                        <Path Data="M 1,6 L 4.5,9.5 L 12,2" Stroke="White" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource PanelButtonStyle}" MinWidth="0" MinHeight="0"
                            Margin="1,0,0,0" Padding="0" Background="Transparent" BorderBrush="Transparent"
                            ToolTip="取消（Esc）" AutomationProperties.Name="取消" Click="CancelValueButton_Click">
                        <Path Data="M 2,2 L 9,9 M 9,2 L 2,9" Stroke="#415E65" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <TextBlock x:Name="ValueEditorError" Grid.Row="1" Grid.ColumnSpan="3" Margin="3,3,2,1"
                               Foreground="#9D3340" FontSize="11" TextWrapping="Wrap" MaxHeight="32"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</views:PlcToolPage>