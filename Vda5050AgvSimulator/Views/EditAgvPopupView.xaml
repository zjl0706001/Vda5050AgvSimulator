<UserControl x:Class="Vda5050AgvSimulator.Views.EditAgvPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             FontFamily="Microsoft YaHei UI"
             FontSize="13"
             Foreground="#172B4D"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <SolidColorBrush x:Key="AgvPageBrush" Color="#F2F5FA" />
        <SolidColorBrush x:Key="AgvBorderBrush" Color="#DCE5F0" />
        <SolidColorBrush x:Key="AgvMutedBrush" Color="#536580" />
        <SolidColorBrush x:Key="AgvAccentBrush" Color="#245EDB" />
        <SolidColorBrush x:Key="AgvAccentSurfaceBrush" Color="#EAF2FF" />
        <SolidColorBrush x:Key="AgvReadOnlyBrush" Color="#F3F6FA" />

        <Style x:Key="AgvCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AgvBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="AgvCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AgvFieldStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,12,10" />
        </Style>

        <Style x:Key="AgvFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource AgvMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="AgvTextInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AgvBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#B6C6DB" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush"
                                        Value="{StaticResource AgvAccentBrush}" />
                            </Trigger>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#B43C48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="{StaticResource AgvReadOnlyBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource AgvMutedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AgvComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Option"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Option" Property="Background"
                                        Value="{StaticResource AgvAccentSurfaceBrush}" />
                                <Setter Property="Foreground" Value="#204FAE" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Option" Property="Background" Value="#E1EDFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="AgvComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="35" />
            <Setter Property="Padding" Value="10,0,28,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource AgvBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MaxDropDownHeight" Value="270" />
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource AgvComboItemStyle}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">

                            <!-- 自适应整个控件宽度 -->
                            <ToggleButton
                                x:Name="DropDownToggle"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Focusable="False"
                                IsTabStop="False"
                                ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen,
                            Mode=TwoWay,
                            RelativeSource={RelativeSource TemplatedParent}}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="7">

                                            <Path
                                                Data="M 0,0 L 4,4 L 8,0"
                                                Stroke="{StaticResource AgvMutedBrush}"
                                                StrokeThickness="1.5"
                                                StrokeStartLineCap="Round"
                                                StrokeEndLineCap="Round"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,11,0" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- 选中内容自动占用可用区域 -->
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                            <!-- 自适应下拉弹窗 -->
                            <Popup
                                x:Name="PART_Popup"
                                Placement="Bottom"
                                PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                AllowsTransparency="True"
                                IsOpen="{TemplateBinding IsDropDownOpen}">

                                <Border
                                    Background="White"
                                    BorderBrush="{StaticResource AgvBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4"
                                    Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth,
                                RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">

                                    <ScrollViewer
                                        CanContentScroll="True"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DropDownToggle"
                                        Property="BorderBrush"
                                        Value="#B6C6DB" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DropDownToggle"
                                        Property="BorderBrush"
                                        Value="{StaticResource AgvAccentBrush}" />
                            </Trigger>

                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="DropDownToggle"
                                        Property="BorderBrush"
                                        Value="{StaticResource AgvAccentBrush}" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DropDownToggle"
                                        Property="Background"
                                        Value="{StaticResource AgvReadOnlyBrush}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource AgvMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="AgvButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#253B5B" />
            <Setter Property="BorderBrush" Value="{StaticResource AgvBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="7">
                                <ContentPresenter RecognizesAccessKey="True"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="HoverLayer"
                                    Background="#0D172B4D"
                                    CornerRadius="7"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverLayer" Property="Background" Value="#21172B4D" />
                                <Setter TargetName="HoverLayer" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                        Value="{StaticResource AgvAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AgvPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AgvButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AgvAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AgvAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AgvTableButtonStyle" TargetType="Button" BasedOn="{StaticResource AgvButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="AgvDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource AgvTableButtonStyle}">
            <Setter Property="Foreground" Value="#9A3741" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AgvSelectionCountStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource AgvMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AgvGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF3FA" />
            <Setter Property="Foreground" Value="{StaticResource AgvMutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AgvBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="AgvGridCellStyle" TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8F0FF" />
                    <Setter Property="Foreground" Value="#173E86" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AgvAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AgvGridTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="8,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style x:Key="AgvEditorGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="36" />
            <Setter Property="ColumnHeaderHeight" Value="35" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EAF0F7" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFD" />
            <Setter Property="BorderBrush" Value="{StaticResource AgvBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource AgvGridHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource AgvGridCellStyle}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </UserControl.Resources>

    <Border Width="760"
            MaxHeight="820"
            Background="White"
            BorderBrush="{StaticResource AgvBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#182C4B" BlurRadius="22" ShadowDepth="4" Opacity="0.18" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题区保留拖动交互。 -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource AgvBorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <primitives:Thumb Grid.Column="0" Cursor="SizeAll"
                                      DragDelta="HeaderDragThumb_DragDelta">
                        <primitives:Thumb.Template>
                            <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </primitives:Thumb.Template>
                    </primitives:Thumb>

                    <DockPanel Grid.Column="0" IsHitTestVisible="False" LastChildFill="True">
                        <Border Width="44" Height="44"
                                Margin="0,0,13,0" CornerRadius="10"
                                Background="{StaticResource AgvAccentSurfaceBrush}">
                            <Path Data="M 2,4 H 18 V 15 H 2 Z M 6,8 H 14 M 6,15 V 18 M 14,15 V 18 M 8,11 H 12"
                                  Stroke="{StaticResource AgvAccentBrush}"
                                  StrokeThickness="1.6"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="编辑 AGV" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock FontSize="12" Foreground="{StaticResource AgvMutedBrush}"
                                       Margin="0,4,0,0">
                                <Run Text="设备编号 " /><Run Text="{Binding EditingAgv.DeviceID, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <Button Grid.Column="1" Style="{StaticResource AgvButtonStyle}"
                            Width="34" Height="34" Padding="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="关闭"
                            ToolTip="关闭"
                            Click="CloseButton_Click">
                        <Path Data="M 1,1 L 10,10 M 10,1 L 1,10"
                              Stroke="{StaticResource AgvMutedBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Background="{StaticResource AgvPageBrush}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,16">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource AgvCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AgvCardTitleStyle}" Text="设备与通信" />
                                <StackPanel Style="{StaticResource AgvFieldStyle}" Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="设备类型" />
                                    <TextBox Style="{StaticResource AgvTextInputStyle}"
                                             AutomationProperties.Name="设备类型"
                                             Text="{Binding DeviceTypeText, Mode=OneWay}"
                                             IsReadOnly="True" />
                                </StackPanel>
                                <UniformGrid Columns="2" Margin="0,0,-12,-10">
                                    <StackPanel Style="{StaticResource AgvFieldStyle}">
                                        <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="本地 IP" />
                                        <TextBox Style="{StaticResource AgvTextInputStyle}"
                                                 AutomationProperties.Name="本地 IP"
                                                 Text="{Binding EditingAgv.LocalIP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource AgvFieldStyle}">
                                        <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="本地端口" />
                                        <TextBox Style="{StaticResource AgvTextInputStyle}"
                                                 AutomationProperties.Name="本地端口"
                                                 Text="{Binding EditingAgv.LocalPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource AgvFieldStyle}">
                                        <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="远程 IP" />
                                        <TextBox Style="{StaticResource AgvTextInputStyle}"
                                                 AutomationProperties.Name="远程 IP"
                                                 Text="{Binding EditingAgv.RemoteIP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource AgvFieldStyle}">
                                        <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="远程端口" />
                                        <TextBox Style="{StaticResource AgvTextInputStyle}"
                                                 AutomationProperties.Name="远程端口"
                                                 Text="{Binding EditingAgv.RemotePort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource AgvCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AgvCardTitleStyle}" Text="位置与载货" />
                                <UniformGrid Columns="2" Margin="0,0,-12,-10">
                                    <StackPanel Style="{StaticResource AgvFieldStyle}">
                                        <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="地标点" />
                                        <TextBox x:Name="PositionIdTextBox"
                                                 Style="{StaticResource AgvTextInputStyle}"
                                                 AutomationProperties.Name="地标点"
                                                 Text="{Binding EditingAgv.PositionID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="PositionIdTextBox_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource AgvFieldStyle}">
                                        <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="角度（°）" />
                                        <TextBox Style="{StaticResource AgvTextInputStyle}"
                                                 AutomationProperties.Name="角度（°）"
                                                 Text="{Binding EditingAgv.Angle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource AgvFieldStyle}">
                                        <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="坐标 X（m）" />
                                        <TextBox x:Name="CoordinateXTextBox"
                                                 Style="{StaticResource AgvTextInputStyle}"
                                                 AutomationProperties.Name="坐标 X（m）"
                                                 Text="{Binding EditingAgv.X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="True" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource AgvFieldStyle}">
                                        <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="坐标 Y（m）" />
                                        <TextBox x:Name="CoordinateYTextBox"
                                                 Style="{StaticResource AgvTextInputStyle}"
                                                 AutomationProperties.Name="坐标 Y（m）"
                                                 Text="{Binding EditingAgv.Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="True" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource AgvFieldStyle}">
                                        <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="载货状态" />
                                        <ComboBox Style="{StaticResource AgvComboStyle}"
                                                  AutomationProperties.Name="载货状态"
                                                  ItemsSource="{Binding LoadStatusOptions}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding EditingAgv.LoadStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource AgvFieldStyle}">
                                        <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="报警码" />
                                        <TextBox Style="{StaticResource AgvTextInputStyle}"
                                                 AutomationProperties.Name="报警码"
                                                 Text="{Binding EditingAgv.AlarmCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource AgvCardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AgvCardTitleStyle}" Text="运行参数" />
                            <UniformGrid Columns="4" Margin="0,0,-12,-10">
                                <StackPanel Style="{StaticResource AgvFieldStyle}">
                                    <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="运行状态" />
                                    <ComboBox Style="{StaticResource AgvComboStyle}"
                                              AutomationProperties.Name="运行状态"
                                              ItemsSource="{Binding RunStatusOptions}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding EditingAgv.RunStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource AgvFieldStyle}">
                                    <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="运行方向" />
                                    <ComboBox Style="{StaticResource AgvComboStyle}"
                                              AutomationProperties.Name="运行方向"
                                              ItemsSource="{Binding RunDirectionOptions}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding EditingAgv.RunDirection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource AgvFieldStyle}">
                                    <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="运行速度（m/s）" />
                                    <TextBox Style="{StaticResource AgvTextInputStyle}"
                                             AutomationProperties.Name="运行速度（m/s）"
                                             Language="en-US"
                                             Text="{Binding EditingAgv.Speed, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource AgvFieldStyle}">
                                    <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="避障区域" />
                                    <ComboBox Style="{StaticResource AgvComboStyle}"
                                              AutomationProperties.Name="避障区域"
                                              ItemsSource="{Binding DodgeAreaOptions}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding EditingAgv.DodgeArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource AgvFieldStyle}">
                                    <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="在线状态" />
                                    <ComboBox Style="{StaticResource AgvComboStyle}"
                                              AutomationProperties.Name="在线状态"
                                              ItemsSource="{Binding OnlineStatusOptions}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding EditingAgv.OnlineStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource AgvFieldStyle}">
                                    <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="管制状态" />
                                    <ComboBox Style="{StaticResource AgvComboStyle}"
                                              AutomationProperties.Name="管制状态"
                                              ItemsSource="{Binding TrafficStatusOptions}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding EditingAgv.TrafficStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource AgvFieldStyle}">
                                    <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="充电状态" />
                                    <ComboBox Style="{StaticResource AgvComboStyle}"
                                              AutomationProperties.Name="充电状态"
                                              ItemsSource="{Binding ChargeStatusOptions}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding EditingAgv.ChargeStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource AgvFieldStyle}">
                                    <TextBlock Style="{StaticResource AgvFieldLabelStyle}" Text="电量（%）" />
                                    <TextBox Style="{StaticResource AgvTextInputStyle}"
                                             AutomationProperties.Name="电量（%）"
                                             Text="{Binding EditingAgv.Equantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AgvCardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="新增动作"
                                            Style="{StaticResource AgvTableButtonStyle}"
                                            Margin="0,0,8,0"
                                            Click="AddActionButton_Click" />
                                    <Button Content="全选"
                                            Style="{StaticResource AgvTableButtonStyle}"
                                            Margin="0,0,8,0"
                                            Command="{x:Static ApplicationCommands.SelectAll}"
                                            CommandTarget="{Binding ElementName=ActionDataGrid}" />
                                    <Button Content="删除选中"
                                            Style="{StaticResource AgvDeleteButtonStyle}"
                                            Tag="{Binding SelectedItem, ElementName=ActionDataGrid}"
                                            Click="DeleteActionButton_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            ToolTip="按住 Ctrl 点选多行，按住 Shift 连续选行。">
                                    <TextBlock Text="动作列表" Style="{StaticResource AgvCardTitleStyle}" Margin="0" />
                                    <TextBlock Style="{StaticResource AgvSelectionCountStyle}"
                                               Text="{Binding SelectedItems.Count, ElementName=ActionDataGrid, StringFormat='已选 {0} 行'}" />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid x:Name="ActionDataGrid"
                                      Style="{StaticResource AgvEditorGridStyle}"
                                      Height="174"
                                      ItemsSource="{Binding ActionEditors}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="actionId" Width="1.1*" MinWidth="90"
                                                        ElementStyle="{StaticResource AgvGridTextStyle}"
                                                        Binding="{Binding ActionId, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="actionType" Width="1.1*" MinWidth="100"
                                                        ElementStyle="{StaticResource AgvGridTextStyle}"
                                                        Binding="{Binding ActionType, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTemplateColumn Header="blockingType" Width="1.05*" MinWidth="108">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource AgvGridTextStyle}"
                                                           Text="{Binding BlockingType}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource AgvComboStyle}" Height="32"
                                                          ItemsSource="{Binding DataContext.BlockingTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding BlockingType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="描述" Width="*" MinWidth="80"
                                                        ElementStyle="{StaticResource AgvGridTextStyle}"
                                                        Binding="{Binding ActionDescription, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="参数Key" Width="*" MinWidth="80"
                                                        ElementStyle="{StaticResource AgvGridTextStyle}"
                                                        Binding="{Binding ParameterKey, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="参数Value" Width="1.1*" MinWidth="92"
                                                        ElementStyle="{StaticResource AgvGridTextStyle}"
                                                        Binding="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AgvCardStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="由全部动作生成"
                                            ToolTip="按全部动作重新生成，替换当前动作状态列表。"
                                            Style="{StaticResource AgvTableButtonStyle}"
                                            Margin="0,0,8,0"
                                            Click="GenerateActionStatesButton_Click" />
                                    <Button Content="新增状态"
                                            ToolTip="为动作列表中选中的每个动作新增一条状态。未选择动作时新增一条默认状态。"
                                            Style="{StaticResource AgvTableButtonStyle}"
                                            Margin="0,0,8,0"
                                            Click="AddActionStateButton_Click" />
                                    <Button Content="全选"
                                            Style="{StaticResource AgvTableButtonStyle}"
                                            Margin="0,0,8,0"
                                            Command="{x:Static ApplicationCommands.SelectAll}"
                                            CommandTarget="{Binding ElementName=ActionStateDataGrid}" />
                                    <Button Content="删除选中"
                                            Style="{StaticResource AgvDeleteButtonStyle}"
                                            Tag="{Binding SelectedItem, ElementName=ActionStateDataGrid}"
                                            Click="DeleteActionStateButton_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            ToolTip="按住 Ctrl 点选多行，按住 Shift 连续选行。">
                                    <TextBlock Text="动作状态列表" Style="{StaticResource AgvCardTitleStyle}" Margin="0" />
                                    <TextBlock Style="{StaticResource AgvSelectionCountStyle}"
                                               Text="{Binding SelectedItems.Count, ElementName=ActionStateDataGrid, StringFormat='已选 {0} 行'}" />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid x:Name="ActionStateDataGrid"
                                      Style="{StaticResource AgvEditorGridStyle}"
                                      Height="194"
                                      ItemsSource="{Binding ActionStateEditors}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="actionId" Width="1.1*" MinWidth="104"
                                                        ElementStyle="{StaticResource AgvGridTextStyle}"
                                                        Binding="{Binding ActionId, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="actionType" Width="1.1*" MinWidth="100"
                                                        ElementStyle="{StaticResource AgvGridTextStyle}"
                                                        Binding="{Binding ActionType, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="描述" Width="*" MinWidth="82"
                                                        ElementStyle="{StaticResource AgvGridTextStyle}"
                                                        Binding="{Binding ActionDescription, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTemplateColumn Header="状态" Width="*" MinWidth="94">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource AgvGridTextStyle}"
                                                           Text="{Binding ActionStatus}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource AgvComboStyle}" Height="32"
                                                          ItemsSource="{Binding DataContext.ActionStatusOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding ActionStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="结果描述" Width="1.35*" MinWidth="112"
                                                        ElementStyle="{StaticResource AgvGridTextStyle}"
                                                        Binding="{Binding ResultDescription, UpdateSourceTrigger=PropertyChanged}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="{StaticResource AgvBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14"
                    Padding="20,11">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Style="{StaticResource AgvButtonStyle}"
                            MinWidth="84"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click" />
                    <Button Content="保存修改"
                            Style="{StaticResource AgvPrimaryButtonStyle}"
                            MinWidth="112"
                            Click="SaveButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>