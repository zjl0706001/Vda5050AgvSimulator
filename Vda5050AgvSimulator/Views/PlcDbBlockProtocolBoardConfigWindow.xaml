<Window x:Class="Vda5050AgvSimulator.Views.PlcDbBlockProtocolBoardConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DB 协议看板" Width="1180" Height="660" MinWidth="760" MinHeight="480"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#F2F5FA" Foreground="#172B4D" FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="LineBrush" Color="#DCE5F0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#536580" />
        <SolidColorBrush x:Key="AccentBrush" Color="#245EDB" />
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="0,2,6,2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#2B405E" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#799CCA" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#173E86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF3FA" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8F0FF" />
                    <Setter Property="Foreground" Value="#173E86" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="#779CDF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,14,0"
                               ToolTip="{Binding RunningStatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="PLC 未运行" />
                                <Setter Property="Foreground" Value="#865315" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlcRunning}" Value="True">
                                        <Setter Property="Text" Value="PLC 运行中" />
                                        <Setter Property="Foreground" Value="#176748" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="TopmostButton" Content="置顶" Style="{StaticResource ToolButtonStyle}"
                            Click="TopmostButton_Click" />
                    <Button Content="打开操作面板" Style="{StaticResource PrimaryButtonStyle}" Margin="0"
                            Click="OpenOperationPanelButton_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="协议看板" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}">
                        <Run Text="PLC " /><Run Text="{Binding PlcId, Mode=OneWay}" /><Run Text="  /  DB" /><Run Text="{Binding DbNumber, Mode=OneWay}" />
                        <Run Text=" · " /><Run Text="{Binding ProtocolRows.Count, Mode=OneWay}" /><Run Text=" 个协议项" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8" VerticalAlignment="Center">
            <CheckBox Margin="2,2,14,2" Height="32" VerticalContentAlignment="Center" Content="自动刷新当前值"
                      IsChecked="{Binding AutoRefreshEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="刷新值" Style="{StaticResource ToolButtonStyle}" Click="RefreshValuesButton_Click" />
            <Button Content="写入选中" Style="{StaticResource ToolButtonStyle}" Margin="0,2,16,2"
                    Click="WriteSelectedValueButton_Click" />
            <CheckBox x:Name="LocalModeBox" Content="编辑本块自定义项" VerticalContentAlignment="Center"
                      Margin="0,2,12,2" Click="LocalModeBox_Click" />
            <Button Content="新增自定义项" Style="{StaticResource ToolButtonStyle}" IsEnabled="{Binding IsEditingLocal}"
                    Click="AddProtocolItemButton_Click" />
            <Button Content="删除选中" Style="{StaticResource ToolButtonStyle}" IsEnabled="{Binding IsEditingLocal}"
                    Click="RemoveProtocolItemButton_Click" />
            <Button Content="清空自定义项" Style="{StaticResource ToolButtonStyle}" IsEnabled="{Binding IsEditingLocal}"
                    Foreground="#9A3741" Click="ClearProtocolItemsButton_Click" />
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="6">
            <DataGrid x:Name="ProtocolDataGrid"
                      ItemsSource="{Binding ProtocolRows}"
                      SelectedItem="{Binding SelectedProtocolRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                      Background="White" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#F8FAFD"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E9EFF6"
                      RowHeight="36" ColumnHeaderHeight="34"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn x:Name="EnabledColumn" Header="启用"
                                            Width="55"
                                            Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <DataGridTextColumn ElementStyle="{StaticResource CellTextStyle}" x:Name="IdColumn" Header="ID"
                                        Width="50"
                                        Binding="{Binding ProtocolItemId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <DataGridTextColumn ElementStyle="{StaticResource CellTextStyle}" x:Name="NameColumn" Header="名称"
                                        Width="1.2*" MinWidth="110"
                                        Binding="{Binding SignalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <DataGridTemplateColumn x:Name="DataTypeColumn" Header="数据类型"
                                            Width="108">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataType}" Style="{StaticResource CellTextStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox
                                    ItemsSource="{Binding DataContext.DataTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Text="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEditable="True"
                                    IsTextSearchEnabled="False"
                                    BorderThickness="0"
                                    Padding="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="AddressColumn" Header="地址"
                                            Width="146"
                                            SortMemberPath="DisplayAddress">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayAddress}"
                                           ToolTip="{Binding DisplayAddress}"
                                           Margin="4,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding OffsetAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn ElementStyle="{StaticResource CellTextStyle}" Header="当前值"
                                        Width="90"
                                        IsReadOnly="True"
                                        Binding="{Binding CurrentValue}" />

                    <DataGridTextColumn ElementStyle="{StaticResource CellTextStyle}" Header="写入值"
                                        Width="90"
                                        Binding="{Binding WriteValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <DataGridTemplateColumn Header="操作"
                                            Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="写入" Style="{StaticResource ToolButtonStyle}"
                                        MinWidth="53" Height="26" Padding="8,0" Margin="0"
                                        Background="#EAF2FF" BorderBrush="#CADAF5" Foreground="#234E9A"
                                        HorizontalAlignment="Center"
                                        Click="WriteRowValueButton_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn ElementStyle="{StaticResource CellTextStyle}" x:Name="RemarkColumn" Header="注释"
                                        Width="1.8*" MinWidth="120"
                                        Binding="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <DataGridTextColumn ElementStyle="{StaticResource CellTextStyle}" Header="状态"
                                        Width="1.2*" MinWidth="105"
                                        IsReadOnly="True"
                                        Binding="{Binding LastMessage}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="2,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock x:Name="ModeHintText" Foreground="#245AA4" TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="Bool 默认取反，也可填 true/false、1/0 或是/否。整数支持十进制和 0x，Real 可填 12.34，String 可填 ASCII 或留空清除，ByteArray 可填 01 02 FF。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="应用配置" Style="{StaticResource PrimaryButtonStyle}" Click="OkButton_Click" />
                <Button Content="取消" Style="{StaticResource ToolButtonStyle}" Margin="0" Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
