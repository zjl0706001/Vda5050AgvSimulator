<views:PlcToolPage x:Class="Vda5050AgvSimulator.Views.DbBlockBitsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:views="clr-namespace:Vda5050AgvSimulator.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:plc="clr-namespace:Vda5050AgvSimulator.Models.Plc"
        Title="DB块位值查看"
        Background="#F5F7FA">

    <views:PlcToolPage.Resources>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="NormalButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F7" />
            <Setter Property="VerticalGridLinesBrush" Value="#EEF2F7" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,0" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#EEF2F7" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <!-- 单元格选中浅蓝色 -->
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="Foreground" Value="#1D4ED8" />
                    <Setter Property="BorderBrush" Value="#BFDBFE" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#111827" />

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <!-- 鼠标悬停更淡一点 -->
                    <Setter Property="Background" Value="#EFF6FF" />
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <!-- 行选中浅蓝色 -->
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="Foreground" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CenterTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="MonoTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource CenterTextStyle}">
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

        <Style x:Key="BitTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="双击取反当前bit位" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </views:PlcToolPage.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding TitleText}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#111827" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0">
                        <TextBlock Text="DBX0.0 表示第 0 个字节 bit0；DBX0.7 表示第 0 个字节 bit7。双击bit单元格可取反写入。"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center" />

                        <Border Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,3"
                                Margin="12,0,0,0">
                            <TextBlock Text="{Binding LastRefreshText}"
                                       FontSize="12"
                                       Foreground="#2563EB" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="刷新"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="RefreshButton_Click" />


                    <Button Content="关闭"
                            Style="{StaticResource NormalButtonStyle}"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="0">
            <DataGrid ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="字节地址"
                                        Width="145"
                                        Binding="{Binding ByteAddress, Mode=OneWay}"
                                        ElementStyle="{StaticResource MonoTextStyle}" />

                    <DataGridTextColumn Header="十进制"
                                        Width="90"
                                        Binding="{Binding DecimalValue, Mode=OneWay}"
                                        ElementStyle="{StaticResource CenterTextStyle}" />

                    <DataGridTextColumn Header="十六进制"
                                        Width="120"
                                        Binding="{Binding HexValue, Mode=OneWay}"
                                        ElementStyle="{StaticResource MonoTextStyle}" />

                    <DataGridTextColumn Header="二进制"
                                        Width="140"
                                        Binding="{Binding BinaryValue, Mode=OneWay}"
                                        ElementStyle="{StaticResource MonoTextStyle}" />

                    <DataGridTemplateColumn Header="bit0" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="plc:DbBlockBitRowModel">
                                <TextBlock Tag="0"
                                           MouseLeftButtonDown="BitTextBlock_MouseLeftButtonDown">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BitTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Bit0}" Value="True">
                                                    <Setter Property="Text" Value="1" />
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="bit1" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="plc:DbBlockBitRowModel">
                                <TextBlock Tag="1"
                                           MouseLeftButtonDown="BitTextBlock_MouseLeftButtonDown">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BitTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Bit1}" Value="True">
                                                    <Setter Property="Text" Value="1" />
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="bit2" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="plc:DbBlockBitRowModel">
                                <TextBlock Tag="2"
                                           MouseLeftButtonDown="BitTextBlock_MouseLeftButtonDown">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BitTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Bit2}" Value="True">
                                                    <Setter Property="Text" Value="1" />
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="bit3" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="plc:DbBlockBitRowModel">
                                <TextBlock Tag="3"
                                           MouseLeftButtonDown="BitTextBlock_MouseLeftButtonDown">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BitTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Bit3}" Value="True">
                                                    <Setter Property="Text" Value="1" />
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="bit4" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="plc:DbBlockBitRowModel">
                                <TextBlock Tag="4"
                                           MouseLeftButtonDown="BitTextBlock_MouseLeftButtonDown">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BitTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Bit4}" Value="True">
                                                    <Setter Property="Text" Value="1" />
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="bit5" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="plc:DbBlockBitRowModel">
                                <TextBlock Tag="5"
                                           MouseLeftButtonDown="BitTextBlock_MouseLeftButtonDown">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BitTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Bit5}" Value="True">
                                                    <Setter Property="Text" Value="1" />
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="bit6" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="plc:DbBlockBitRowModel">
                                <TextBlock Tag="6"
                                           MouseLeftButtonDown="BitTextBlock_MouseLeftButtonDown">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BitTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Bit6}" Value="True">
                                                    <Setter Property="Text" Value="1" />
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="bit7" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate  DataType="plc:DbBlockBitRowModel">
                                <TextBlock Tag="7"
                                           MouseLeftButtonDown="BitTextBlock_MouseLeftButtonDown">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BitTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Bit7}" Value="True">
                                                    <Setter Property="Text" Value="1" />
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</views:PlcToolPage>