<Window x:Class="Vda5050AgvSimulator.Views.PlcGlobalAutoWriteRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全局自动写入规则"
        Width="1240" Height="770"
        MinWidth="1000" MinHeight="610"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Foreground="#172B4D"
        Background="#F2F5FA"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE5F0" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#536580" />
        <SolidColorBrush x:Key="AccentBrush" Color="#245EDB" />
        <SolidColorBrush x:Key="RulePageBrush" Color="#F2F5FA" />
        <SolidColorBrush x:Key="RuleIconBrush" Color="#EAF2FF" />

        <Style x:Key="RuleCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="RuleBandStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="Padding" Value="22,14" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RuleHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="NormalButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#253B5B" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <Border x:Name="HoverLayer" CornerRadius="7" Background="#0D172B4D"
                                    Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverLayer" Property="Background" Value="#1F172B4D" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NormalButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource NormalButtonStyle}">
            <Setter Property="Foreground" Value="#204FAE" />
            <Setter Property="Background" Value="#EAF2FF" />
            <Setter Property="BorderBrush" Value="#C5D8FA" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MaintenanceButtonStyle" TargetType="Button" BasedOn="{StaticResource NormalButtonStyle}">
            <Setter Property="Foreground" Value="#9A3741" />
        </Style>
        <Style x:Key="RuleEnabledSwitchStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="36" Height="20" Padding="2"
                                BorderBrush="#B8C8DA" BorderThickness="1"
                                Background="#D3DEEB" CornerRadius="10">
                            <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7"
                                    Background="White" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#17479E" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#173E86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RuleGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF3FA" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Padding" Value="9,0,4,0" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="RuleGridCellStyle" TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8F0FF" />
                    <Setter Property="Foreground" Value="#173E86" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RuleGridTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="9,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style x:Key="RuleGridAddressStyle" TargetType="TextBlock" BasedOn="{StaticResource RuleGridTextStyle}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style x:Key="RuleEditorGridStyle" TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="ColumnHeaderHeight" Value="37" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFD" />
            <Setter Property="Background" Value="White" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EAF0F7" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource RuleGridHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource RuleGridCellStyle}" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="TemplateSelectCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource RuleBandStyle}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Border Width="44" Height="44" CornerRadius="10"
                        Background="{StaticResource RuleIconBrush}" Margin="0,0,14,0"
                        DockPanel.Dock="Left">
                    <Path Data="M 2,4 H 18 M 2,10 H 18 M 2,16 H 18 M 6,2 V 6 M 14,8 V 12 M 8,14 V 18"
                          Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="全局自动写入规则" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource RuleHintStyle}" Margin="0,4,0,0"
                               Text="全部已启用的触发条件满足后执行写入。启用延时时，条件须持续满足设定时长。" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="6*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource RuleCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,11" LastChildFill="True">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="新增规则" Style="{StaticResource AccentButtonStyle}"
                                    Click="AddRuleButton_Click" />
                            <Button Content="请求进入模板" Style="{StaticResource NormalButtonStyle}"
                                    Click="AddRequestInTemplateButton_Click" />
                            <Button Content="删除规则" Style="{StaticResource MaintenanceButtonStyle}"
                                    Margin="0" Click="RemoveRuleButton_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="规则列表" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Style="{StaticResource RuleHintStyle}" Margin="9,0,0,0"
                                       Text="{Binding Rules.Count, StringFormat='共 {0} 条'}" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid x:Name="RuleListDataGrid" Grid.Row="1"
                              Style="{StaticResource RuleEditorGridStyle}"
                              ItemsSource="{Binding Rules}"
                              SelectedItem="{Binding SelectedRule, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="启用" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource RuleEnabledSwitchStyle}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="RuleEnabledCheckBox_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="规则 ID"
                                                Width="70"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource RuleGridTextStyle}"
                                                Binding="{Binding RuleId}" />
                            <DataGridTextColumn Header="规则名称"
                                                Width="1.2*" MinWidth="175"
                                                ElementStyle="{StaticResource RuleGridTextStyle}"
                                                Binding="{Binding RuleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridCheckBoxColumn Header="规则延时"
                                                    Width="82"
                                                    Binding="{Binding DelayTriggerEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <DataGridTextColumn Header="延时（ms）"
                                                Width="112"
                                                ElementStyle="{StaticResource RuleGridTextStyle}"
                                                Binding="{Binding DelayMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="备注"
                                                Width="*" MinWidth="110"
                                                ElementStyle="{StaticResource RuleGridTextStyle}"
                                                Binding="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.11*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource RuleCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,11" LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="新增条件" Style="{StaticResource AccentButtonStyle}"
                                        Click="AddTriggerButton_Click" />
                                <Button Content="默认模板" Style="{StaticResource NormalButtonStyle}"
                                        Click="AddDefaultTemplateButton_Click" />
                                <Button Content="删除" Style="{StaticResource MaintenanceButtonStyle}"
                                        Margin="0" Click="RemoveTriggerButton_Click" />
                            </StackPanel>
                            <TextBlock Text="触发条件" Style="{StaticResource SectionTitleStyle}" />
                        </DockPanel>

                        <DataGrid x:Name="RuleTriggersDataGrid" Grid.Row="1"
                                  Style="{StaticResource RuleEditorGridStyle}"
                                  ItemsSource="{Binding SelectedRule.Triggers}"
                                  SelectedItem="{Binding SelectedTrigger, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="启用" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource RuleEnabledSwitchStyle}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="TriggerEnabledCheckBox_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ID"
                                                    Width="46"
                                                    ElementStyle="{StaticResource RuleGridTextStyle}"
                                                    Binding="{Binding TriggerId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="名称"
                                                    Width="1.1*" MinWidth="86"
                                                    ElementStyle="{StaticResource RuleGridTextStyle}"
                                                    Binding="{Binding TriggerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="读取地址"
                                                    Width="*" MinWidth="89"
                                                    ElementStyle="{StaticResource RuleGridAddressStyle}"
                                                    Binding="{Binding ReadAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridCheckBoxColumn Header="触发值"
                                                        Width="61"
                                                        Binding="{Binding TriggerValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="备注"
                                                    Width="*" MinWidth="84"
                                                    ElementStyle="{StaticResource RuleGridTextStyle}"
                                                    Binding="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource RuleCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,11" LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="新增写入" Style="{StaticResource AccentButtonStyle}"
                                        Click="AddWriteItemButton_Click" />
                                <Button Content="默认模板" Style="{StaticResource NormalButtonStyle}"
                                        Click="AddDefaultTemplateButton_Click" />
                                <Button Content="删除" Style="{StaticResource MaintenanceButtonStyle}"
                                        Margin="0" Click="RemoveWriteItemButton_Click" />
                            </StackPanel>
                            <TextBlock Text="写入动作" Style="{StaticResource SectionTitleStyle}" />
                        </DockPanel>

                        <DataGrid x:Name="RuleWritesDataGrid" Grid.Row="1"
                                  Style="{StaticResource RuleEditorGridStyle}"
                                  ItemsSource="{Binding SelectedRule.WriteItems}"
                                  SelectedItem="{Binding SelectedWriteItem, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="启用" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource RuleEnabledSwitchStyle}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="WriteItemEnabledCheckBox_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ID"
                                                    Width="44"
                                                    ElementStyle="{StaticResource RuleGridTextStyle}"
                                                    Binding="{Binding WriteId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="名称"
                                                    Width="1.05*" MinWidth="79"
                                                    ElementStyle="{StaticResource RuleGridTextStyle}"
                                                    Binding="{Binding WriteName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="写入地址"
                                                    Width="*" MinWidth="84"
                                                    ElementStyle="{StaticResource RuleGridAddressStyle}"
                                                    Binding="{Binding WriteAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridCheckBoxColumn Header="写值"
                                                        Width="49"
                                                        Binding="{Binding WriteValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridCheckBoxColumn Header="复位"
                                                        Width="49"
                                                        Binding="{Binding ResetWhenNotTrigger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridCheckBoxColumn Header="复值"
                                                        Width="49"
                                                        Binding="{Binding ResetValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="备注"
                                                    Width="*" MinWidth="77"
                                                    ElementStyle="{StaticResource RuleGridTextStyle}"
                                                    Binding="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource RuleBandStyle}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="关闭" Style="{StaticResource NormalButtonStyle}" MinWidth="76"
                            Click="CloseButton_Click" />
                    <Button Content="保存全局规则" Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0" MinWidth="118" Click="SaveButton_Click" />
                </StackPanel>
                <TextBlock Style="{StaticResource RuleHintStyle}" Margin="0,0,16,0"
                           Text="偏移地址如 5.0 按绑定的 DB 块解析，也支持 DB{DB}.5.0 和 DB1500.5.0。修改地址等配置后，在 PLC 配置页保存以重载运行中的 PLC。" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
