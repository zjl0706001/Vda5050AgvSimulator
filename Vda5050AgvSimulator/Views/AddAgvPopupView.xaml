<UserControl x:Class="Vda5050AgvSimulator.Views.AddAgvPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <UserControl.Resources>

        <!-- 表单标签 -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- 分组标题 -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- 分组卡片 -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- 输入框 -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Margin="0" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                                <Setter Property="Foreground" Value="#9CA3AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 普通按钮 -->
        <Style x:Key="NormalButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9CA3AF" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                                <Setter Property="Foreground" Value="#9CA3AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮 -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource NormalButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1D4ED8" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E40AF" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#93C5FD" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮 -->
        <Style x:Key="CloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource NormalButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Content" Value="×" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

    </UserControl.Resources>

    <Border Width="720"
            Background="#F8FAFC"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="16"
            Padding="0"
            SnapsToDevicePixels="True">

        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="28"
                              ShadowDepth="8"
                              Opacity="0.18" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <!-- 标题栏，可拖动 -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    Padding="22,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <primitives:Thumb Grid.Column="0"
                                      Cursor="SizeAll"
                                      DragDelta="HeaderDragThumb_DragDelta">
                        <primitives:Thumb.Template>
                            <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </primitives:Thumb.Template>
                    </primitives:Thumb>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="添加 AGV"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827" />

                        <TextBlock Text="填写基础设备参数后，快速生成一台或多台模拟 AGV"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <!-- 内容区 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="22,18,22,4">

                    <!-- 基础信息 -->
                    <Border Style="{StaticResource SectionCardStyle}">

                        <StackPanel>
                            <TextBlock Text="基础信息"
                                       Style="{StaticResource SectionTitleStyle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="设备ID"
                                           Style="{StaticResource FormLabelStyle}" />

                                <TextBox Grid.Row="0"
                                         Grid.Column="1"
                                         Text="{Binding DeviceID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="设备数量"
                                           Style="{StaticResource FormLabelStyle}" />

                                <TextBox Grid.Row="0"
                                         Grid.Column="3"
                                         Text="{Binding AGVCount, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0"
                                           Grid.Column="4"
                                           Text="设备类型"
                                           Style="{StaticResource FormLabelStyle}" />

                                <TextBox Grid.Row="0"
                                         Grid.Column="5"
                                         Text="{Binding DeviceType, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 网络配置 -->
                    <Border Style="{StaticResource SectionCardStyle}">

                        <StackPanel>
                            <TextBlock Text="网络配置"
                                       Style="{StaticResource SectionTitleStyle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="本地IP"
                                           Style="{StaticResource FormLabelStyle}" />

                                <TextBox Grid.Row="0"
                                         Grid.Column="1"
                                         Text="{Binding LocalIP, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="本地端口"
                                           Style="{StaticResource FormLabelStyle}" />

                                <TextBox Grid.Row="0"
                                         Grid.Column="3"
                                         Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="远程IP"
                                           Style="{StaticResource FormLabelStyle}" />

                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding RemoteIP, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Text="远程端口"
                                           Style="{StaticResource FormLabelStyle}" />

                                <TextBox Grid.Row="1"
                                         Grid.Column="3"
                                         Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 初始位置 -->
                    <Border Style="{StaticResource SectionCardStyle}"
                            Margin="0">

                        <StackPanel>
                            <TextBlock Text="初始位置"
                                       Style="{StaticResource SectionTitleStyle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="地标点"
                                           Style="{StaticResource FormLabelStyle}" />

                                <TextBox Grid.Row="0"
                                         Grid.Column="1"
                                         Text="{Binding PositionID, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="角度(°)"
                                           Style="{StaticResource FormLabelStyle}" />

                                <TextBox Grid.Row="0"
                                         Grid.Column="3"
                                         Text="{Binding Angle, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="坐标X(m)"
                                           Style="{StaticResource FormLabelStyle}" />

                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Text="坐标Y(m)"
                                           Style="{StaticResource FormLabelStyle}" />

                                <TextBox Grid.Row="1"
                                         Grid.Column="3"
                                         Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="电量(%)"
                                           Style="{StaticResource FormLabelStyle}" />

                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Text="{Binding Equantity, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="2"
                                           Text="默认在线"
                                           Style="{StaticResource FormLabelStyle}" />

                                <Border Grid.Row="2"
                                        Grid.Column="3"
                                        Height="34"
                                        Background="#ECFDF5"
                                        BorderBrush="#BBF7D0"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="#22C55E"
                                                 Margin="0,0,7,0" />

                                        <TextBlock Text="OnlineStatus = 1"
                                                   VerticalAlignment="Center"
                                                   Foreground="#15803D"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16"
                    Padding="18,0">

                <Grid>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button Content="恢复默认"
                                Style="{StaticResource NormalButtonStyle}"
                                Margin="0,0,10,0"
                                Click="RestoreDefaultButton_Click" />

                        <Button Content="添加AGV"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="AddButton_Click" />

                        <Button Content="取消"
                                Style="{StaticResource NormalButtonStyle}"
                                Click="CancelButton_Click" />

                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>