<UserControl x:Class="Vda5050AgvSimulator.Views.AddAgvPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- 表单标签 -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Foreground" Value="#516A71" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="FormFieldStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,12,9" />
        </Style>

        <!-- 分组标题 -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource WorkspaceInkBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- 分组卡片 -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource WorkspaceLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- 输入框 -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource WorkspaceInkBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#BDCDCF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Margin="0" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#82BDBA" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WorkspaceAccentBrush}" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WorkspaceCanvasBrush}" />
                                <Setter Property="Foreground" Value="#819698" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 普通按钮 -->
        <Style x:Key="NormalButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#25464F" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#BDCDCF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WorkspaceCanvasBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#819698" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WorkspaceLineBrush}" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WorkspaceCanvasBrush}" />
                                <Setter Property="Foreground" Value="#819698" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮 -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource NormalButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource WorkspaceAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WorkspaceAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#05696C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#05696C" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#064F53" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#064F53" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#82BDBA" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#82BDBA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Background="{StaticResource WorkspaceCanvasBrush}"
            BorderBrush="{StaticResource WorkspaceLineBrush}"
            BorderThickness="1"
            CornerRadius="9"
            Padding="0"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource WorkspaceLineBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="9,9,0,0"
                    Padding="22,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="添加 AGV"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WorkspaceInkBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="返回车队" Style="{StaticResource NormalButtonStyle}"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <!-- 内容区 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="18,16,18,4">

                    <!-- 基础信息 -->
                    <Border Style="{StaticResource SectionCardStyle}">

                        <StackPanel>
                            <TextBlock Text="基础信息"
                                       Style="{StaticResource SectionTitleStyle}" />

                            <UniformGrid Columns="3">
                                <StackPanel Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="设备 ID" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox AutomationProperties.Name="设备 ID" Text="{Binding DeviceID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="设备数量" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox AutomationProperties.Name="设备数量" Text="{Binding AGVCount, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="设备类型" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox AutomationProperties.Name="设备类型" Text="{Binding DeviceType, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 网络配置 -->
                    <Border Style="{StaticResource SectionCardStyle}">

                        <StackPanel>
                            <TextBlock Text="网络配置"
                                       Style="{StaticResource SectionTitleStyle}" />

                            <UniformGrid Columns="2">
                                <StackPanel Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="本地 IP" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox AutomationProperties.Name="本地 IP" Text="{Binding LocalIP, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="本地端口" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox AutomationProperties.Name="本地端口" Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="远程 IP" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox AutomationProperties.Name="远程 IP" Text="{Binding RemoteIP, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="远程端口" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox AutomationProperties.Name="远程端口" Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 初始位置 -->
                    <Border Style="{StaticResource SectionCardStyle}"
                            Margin="0">

                        <StackPanel>
                            <TextBlock Text="初始位置"
                                       Style="{StaticResource SectionTitleStyle}" />

                            <UniformGrid Columns="2">
                                <StackPanel Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="地标点" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox AutomationProperties.Name="地标点" Text="{Binding PositionID, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="角度（°）" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox AutomationProperties.Name="角度（°）" Text="{Binding Angle, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="坐标 X（m）" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox AutomationProperties.Name="坐标 X（m）" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="坐标 Y（m）" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox AutomationProperties.Name="坐标 Y（m）" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="电量（%）" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox AutomationProperties.Name="电量（%）" Text="{Binding Equantity, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="初始状态" Style="{StaticResource FormLabelStyle}" />
                                    <Border Height="34" Background="#E8F5EE" CornerRadius="5">
                                        <TextBlock Text="在线" Margin="10,0" VerticalAlignment="Center" Foreground="#126549" />
                                    </Border>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="{StaticResource WorkspaceLineBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,9,9"
                    Padding="18,12">

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ValidationText" TextWrapping="Wrap" Foreground="#B42318">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <WrapPanel HorizontalAlignment="Right">

                        <Button Content="恢复默认"
                                Style="{StaticResource NormalButtonStyle}"
                                Margin="0,0,10,0"
                                Click="RestoreDefaultButton_Click" />

                        <Button Content="添加AGV"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="AddButton_Click" />

                        <Button Content="取消"
                                Style="{StaticResource NormalButtonStyle}"
                                Click="CancelButton_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>