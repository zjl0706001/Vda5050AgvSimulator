<Application x:Class="Vda5050AgvSimulator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vda5050AgvSimulator"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- HandyControl 默认皮肤 -->
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />

                <!-- HandyControl 控件样式 -->
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />

                <ResourceDictionary Source="Themes/WorkspaceTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局颜色 -->
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource WorkspaceCanvasColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource WorkspaceInkColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#536D74" />
            <SolidColorBrush x:Key="BorderBrushLight" Color="{StaticResource WorkspaceLineColor}" />

        </ResourceDictionary>
    </Application.Resources>
</Application>